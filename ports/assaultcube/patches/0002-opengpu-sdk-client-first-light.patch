+/* First-light Amiga audio backend.
+ * Deliberately reports no OpenAL device so AssaultCube runs in nosound mode.
+ * Replace with OpenAudio once the graphics/input client is proven. */
+#include <AL/al.h>
+#include <AL/alc.h>
+#include <vorbis/vorbisfile.h>
+#include <string.h>
+
+extern "C" {
+const ALchar *alGetString(ALenum) { return (const ALchar *)"OpenAL unavailable (Amiga first-light)"; }
+ALenum alGetError(void) { return AL_NO_ERROR; }
+void alListenerf(ALenum, ALfloat) {}
+void alListenerfv(ALenum, const ALfloat *) {}
+void alGenSources(ALsizei n, ALuint *p) { if(p) while(n-- > 0) *p++ = 0; }
+void alDeleteSources(ALsizei, const ALuint *) {}
+ALboolean alIsSource(ALuint) { return AL_FALSE; }
