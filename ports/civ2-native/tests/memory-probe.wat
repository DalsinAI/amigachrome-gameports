(module
  (memory (export "memory") 1 4)
  (data (i32.const 16) "AmigaChrome native 68k\00")
  (func (export "load32") (param $p i32) (result i32)
    local.get $p i32.load)
  (func (export "store32") (param $p i32) (param $v i32)
    local.get $p local.get $v i32.store)
  (func (export "load16") (param $p i32) (result i32)
    local.get $p i32.load16_u)
  (func (export "load8") (param $p i32) (result i32)
    local.get $p i32.load8_u)
  (func (export "load64") (param $p i32) (result i64)
    local.get $p i64.load)
  (func (export "store64") (param $p i32) (param $v i64)
    local.get $p local.get $v i64.store)
  (func (export "loadfloat") (param $p i32) (result f32)
    local.get $p f32.load)
  (func (export "storefloat") (param $p i32) (param $v f32)
    local.get $p local.get $v f32.store)
  (func (export "grow") (result i32)
    i32.const 1 memory.grow)
  (func (export "copy") (param $to i32) (param $from i32) (param $n i32)
    local.get $to local.get $from local.get $n memory.copy)
)
