+short DOMNode::getNodeType() const {
+  if (!raw)
+    return ATTRIBUTE_NODE;
+  switch (raw->type) {
+  case OXP_NODE_DOCUMENT:
+    return DOCUMENT_NODE;
+  case OXP_NODE_ELEMENT:
+    return ELEMENT_NODE;
+  case OXP_NODE_TEXT:
+    return TEXT_NODE;
+  case OXP_NODE_CDATA:
+    return CDATA_SECTION_NODE;
+  case OXP_NODE_COMMENT:
+    return COMMENT_NODE;
+  case OXP_NODE_PI:
+    return PROCESSING_INSTRUCTION_NODE;
+  }
+  return 0;
+}
+const XMLCh *DOMNode::getNodeName() const {
+  return owner->intern(raw->type == OXP_NODE_ELEMENT || raw->type == OXP_NODE_PI
+                           ? fullname(raw->prefix, raw->name)
+                       : raw->type == OXP_NODE_TEXT     ? "#text"
+                       : raw->type == OXP_NODE_DOCUMENT ? "#document"
+                       : raw->type == OXP_NODE_COMMENT  ? "#comment"
+                                                        : "#cdata-section");
+}
+DOMNode *DOMNode::getFirstChild() const { return owner->wrap(raw->first); }
+DOMNode *DOMNode::getNextSibling() const { return owner->wrap(raw->next); }
+DOMNodeList *DOMNode::getChildNodes() { return owner->childList(raw); }
+DOMNode *DOMNode::appendChild(DOMNode *n) { return insertBefore(n, nullptr); }
+DOMNode *DOMNode::insertBefore(DOMNode *n, DOMNode *before) {
+  if (!n || oxp_dom_insert(raw, n->raw, before ? before->raw : nullptr))
+    throw DOMException("Invalid XML insertion");
+  ++owner->revision;
+  return n;
+}
+DOMNode *DOMNode::removeChild(DOMNode *n) {
+  if (!n || n->raw->parent != raw || oxp_dom_detach(n->raw))
+    throw DOMException("Invalid XML removal");
+  ++owner->revision;
+  return n;
+}
+const XMLCh *DOMNode::getTextContent() const {
+  std::vector<char> v(oxp_dom_text(raw, nullptr, 0) + 1);
+  oxp_dom_text(raw, v.data(), v.size());
+  buffer = wide(v.data());
+  return buffer.c_str();
+}
+const std::vector<oxp_node *> &DOMNodeList::list() const {
+  if (stamp == doc->revision)
+    return cache;
+  std::vector<oxp_node *> v;
+  std::function<void(oxp_node *)> visit = [&](oxp_node *n) {
+    for (oxp_node *c = n->first; c; c = c->next) {
+      bool match =
+          direct ||
+          (c->type == OXP_NODE_ELEMENT &&
+           (name == "*" ||
+            (useNS ? str(c->name) : fullname(c->prefix, c->name)) == name) &&
+           (!useNS || uri == "*" || str(c->uri) == uri));
+      if (match)
+        v.push_back(c);
+      if (!direct)
+        visit(c);
+    }
+  };
+  visit(root);
+  cache.swap(v);
+  stamp = doc->revision;
+  return cache;
+}
+XMLSize_t DOMNodeList::getLength() const { return list().size(); }
+DOMNode *DOMNodeList::item(XMLSize_t i) const {
+  const auto &v = list();
+  return i < v.size() ? doc->wrap(v[i]) : nullptr;
+}
+DOMElement::~DOMElement() = default;
+const XMLCh *DOMElement::getAttribute(const XMLCh *k) const {
+  std::string key = utf8(k);
+  for (auto *a = raw->attrs; a; a = a->next)
+    if (fullname(a->prefix, a->local) == key)
+      return owner->intern(a->value);
+  return u"";
+}
+const XMLCh *DOMElement::getAttributeNS(const XMLCh *u, const XMLCh *k) const {
+  std::string uri = utf8(u), key = utf8(k);
+  return owner->intern(
+      str(oxp_dom_attr(raw, uri.empty() ? nullptr : uri.c_str(), key.c_str())));
+}
+DOMAttr *DOMElement::getAttributeNode(const XMLCh *k) const {
+  std::string key = utf8(k);
+  for (auto *a = raw->attrs; a; a = a->next)
+    if (fullname(a->prefix, a->local) == key)
+      return owner->wrap(a);
+  return nullptr;
+}
+void DOMElement::setAttribute(const XMLCh *k, const XMLCh *v) {
+  auto key = utf8(k), value = utf8(v);
+  if (oxp_dom_set_attr(raw, nullptr, nullptr, key.c_str(), value.c_str(), 0))
+    throw DOMException("Invalid XML attribute");
+  ++owner->revision;
+}
+void DOMElement::removeAttribute(const XMLCh *k) {
+  auto key = utf8(k);
+  if (oxp_dom_remove_attr(raw, nullptr, key.c_str()))
+    throw DOMException("Invalid XML attribute removal");
+  ++owner->revision;
+}
+DOMNodeList *DOMElement::getElementsByTagName(const XMLCh *k) {
+  std::string name = utf8(k), key = "tag:" + name;
+  auto &i = queries[key];
+  if (!i)
+    i.reset(new DOMNodeList(owner, raw, name, "", false, false));
+  return i.get();
+}
+DOMNodeList *DOMElement::getElementsByTagNameNS(const XMLCh *u,
+                                                const XMLCh *k) {
+  std::string name = utf8(k), uri = utf8(u), key = "ns:" + uri + "\n" + name;
+  auto &i = queries[key];
+  if (!i)
+    i.reset(new DOMNodeList(owner, raw, name, uri, false, true));
+  return i.get();
+}
+DOMNamedNodeMap *DOMElement::getAttributes() {
+  if (!attributes)
+    attributes.reset(new DOMNamedNodeMap(owner, raw));
+  return attributes.get();
