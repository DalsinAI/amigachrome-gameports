+std::string DOMLSSerializer::serialise(DOMNode *n) {
+  oxp_doc *d = oxp_dom_new();
+  if (!d)
+    throw std::bad_alloc();
+  std::unique_ptr<oxp_doc, void (*)(oxp_doc *)> guard(d, oxp_dom_free);
+  std::function<void(oxp_node *, oxp_node *)> copy = [&](oxp_node *src,
+                                                         oxp_node *parent) {
+    auto action = filter ? filter->acceptNode(n->owner->wrap(src))
+                         : DOMNodeFilter::FILTER_ACCEPT;
+    if (action == DOMNodeFilter::FILTER_REJECT)
+      return;
+    if (action == DOMNodeFilter::FILTER_SKIP) {
+      for (auto *c = src->first; c; c = c->next)
+        copy(c, parent);
+      return;
+    }
+    if (src->type == OXP_NODE_DOCUMENT) {
+      for (auto *c = src->first; c; c = c->next)
+        copy(c, parent);
+      return;
+    }
+    if (parent->type == OXP_NODE_DOCUMENT &&
+        (src->type == OXP_NODE_TEXT || src->type == OXP_NODE_CDATA))
+      return;
+    oxp_node *clone = oxp_dom_import(d, src, 0);
+    if (!clone || oxp_dom_insert(parent, clone, nullptr))
+      throw DOMException("XML serialization copy failed");
+    for (auto *a = clone->attrs; a;) {
+      auto *next = a->next;
+      if (a->defaulted)
+        oxp_dom_remove_attr(clone, a->uri, a->local);
+      a = next;
+    }
+    for (auto *c = src->first; c; c = c->next)
+      copy(c, clone);
+  };
+  copy(n->raw, oxp_dom_document(d));
+  std::string out = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n";
+  if (oxp_dom_write(oxp_dom_document(d), append, &out))
+    throw DOMException("XML serialization failed");
+  return out;
+}
+XMLCh *DOMLSSerializer::writeToString(DOMNode *n) {
+  auto s = serialise(n);
+  return XMLString::transcode(s.c_str());
+}
+bool DOMLSSerializer::writeToURI(DOMNode *n, const XMLCh *uri) {
+  auto path = utf8(uri), tmp = path + ".oxp-tmp",
+       backup = path + ".oxp-previous";
+  auto s = serialise(n);
+  {
+    std::ofstream f(tmp, std::ios::binary | std::ios::trunc);
+    if (!f)
+      return false;
+    f.write(s.data(), s.size());
+    f.flush();
+    if (!f) {
+      f.close();
+      std::remove(tmp.c_str());
+      return false;
+    }
+    f.close();
+    if (!f) {
+      std::remove(tmp.c_str());
+      return false;
+    }
+  }
+  if (std::rename(tmp.c_str(), path.c_str()) == 0)
+    return true;
+  /* AmigaDOS Rename may not replace an existing destination. Keep a recoverable
+   * original and restore it if publishing the completely written file fails. */
+  std::ifstream old(path, std::ios::binary);
+  bool exists = old.good();
+  old.close();
+  if (!exists) {
+    std::remove(tmp.c_str());
+    return false;
+  }
+  std::ifstream recovery(backup, std::ios::binary);
+  if (recovery.good()) {
+    std::remove(tmp.c_str());
+    return false;
+  }
+  recovery.close();
+  if (std::rename(path.c_str(), backup.c_str())) {
+    std::remove(tmp.c_str());
+    return false;
+  }
+  if (std::rename(tmp.c_str(), path.c_str())) {
+    std::rename(backup.c_str(), path.c_str());
+    std::remove(tmp.c_str());
+    return false;
+  }
+  std::remove(backup.c_str());
+  return true;
+}
