+void DOMLSParser::error(const std::string &message, const std::string &path,
+                        unsigned long line, unsigned long col) {
+  if (config.errors) {
+    DOMError e;
+    e.message = wide(message);
+    e.location.uri = wide(path);
+    e.location.line = line;
+    e.location.col = col;
+    config.errors->handleError(e);
+  }
+}
+DOMDocument *DOMLSParser::parseURI(const char *p) {
+  DOMLSInput in;
+  in.path = p;
+  return parse(&in);
+}
+DOMDocument *DOMLSParser::parse(DOMLSInput *in) {
+  try {
+    auto data = read(in);
+    char msg[512];
+    oxp_code code;
+    unsigned long line = 0, col = 0;
+    std::unique_ptr<oxp_doc, void (*)(oxp_doc *)> d(
+        oxp_dom_parse(data.data(), data.size(), 0, &code, msg, sizeof msg,
+                      &line, &col),
+        oxp_dom_free);
+    if (!d) {
+      error(msg, in->path, line, col);
+      return nullptr;
+    }
+    auto *root = oxp_dom_root(d.get());
+    const char *xi = "http://www.w3.org/2001/XMLSchema-instance";
+    std::string schema;
+    if (root->uri) {
+      std::istringstream pairs(str(oxp_dom_attr(root, xi, "schemaLocation")));
+      std::string uri, path;
+      while (pairs >> uri) {
+        if (!(pairs >> path))
+          throw XMLException("Malformed schemaLocation");
+        if (uri == root->uri)
+          schema = path;
+      }
+    } else
+      schema = str(oxp_dom_attr(root, xi, "noNamespaceSchemaLocation"));
+    if (schema.empty() || !config.resolver)
+      throw XMLException("Document has no mapped validation schema");
+    auto w = wide(schema), u = wide(str(root->uri)), base = wide(in->path);
+    std::unique_ptr<DOMLSInput> source(config.resolver->resolveResource(
+        u"http://www.w3.org/2001/XMLSchema", u.c_str(), nullptr, w.c_str(),
+        base.c_str()));
+    if (!source)
+      throw XMLException("Unmapped schema: " + schema);
+    std::string key = source->path;
+    auto i = schemas.find(key);
+    oxp_schema_error e;
+    if (i == schemas.end()) {
+      auto text = read(source.get());
+      oxp_schema *s = oxp_schema_compile(text.data(), text.size(), &e);
+      if (!s) {
+        error(e.message, key, e.line);
+        return nullptr;
+      }
+      i = schemas
+              .emplace(key, std::unique_ptr<oxp_schema, void (*)(oxp_schema *)>(
+                                s, oxp_schema_free))
+              .first;
+    }
+    if (oxp_schema_validate(i->second.get(), d.get(), &e)) {
+      error(e.message, in->path, e.line);
+      return nullptr;
+    }
+    return new DOMDocument(d.release());
+  } catch (const std::exception &e) {
+    error(e.what(), in ? in->path : "");
+    throw XMLException(e.what());
+  }
+}
+namespace {
+int append(void *p, const char *s, size_t n) {
+  try {
+    static_cast<std::string *>(p)->append(s, n);
+    return 0;
+  } catch (...) {
+    return -1;
+  }
+}
