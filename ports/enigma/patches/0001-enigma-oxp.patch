+/* Native task-owned sockets and 68040 FPU startup. GPL-2.0-or-later.
+ * Copyright (c) 2026 AmigaChrome Team. */
+#include <exec/execbase.h>
+#include <proto/exec.h>
+#include <proto/bsdsocket.h>
+#include <amitcp/socketbasetags.h>
+#include <errno.h>
+#include <stdlib.h>
+struct Library *SocketBase;
+static void close_network(void)
+{
+    if (SocketBase) { CloseLibrary(SocketBase); SocketBase = 0; }
+}
+int enigma_open_network(void)
+{
+    if (SocketBase) return 0;
+    SocketBase = OpenLibrary("bsdsocket.library", 4);
+    if (!SocketBase) return -1;
+    if (SocketBaseTags(SBTM_SETVAL(SBTC_ERRNOPTR(sizeof(errno))), (ULONG)&errno, TAG_DONE)) {
+        close_network(); return -1;
+    }
+    atexit(close_network);
+    return 0;
+}
+/* The soft-float game build contains no FPU startup or instructions. */
+#if defined(__HAVE_68881__)
+void __fpucheck(void)
+{
+    ULONG fpcr;
+    if (!(SysBase->AttnFlags & (AFF_68881 | AFF_68882 | AFF_FPU40))) {
+        Alert(0x00068881);
+        exit(20);
+    }
+    __asm__ volatile ("fmove.l %%fpcr,%0" : "=d"(fpcr));
+    fpcr &= ~0x30UL;
+    __asm__ volatile ("fmove.l %0,%%fpcr" : : "d"(fpcr));
+}
+
+#endif
