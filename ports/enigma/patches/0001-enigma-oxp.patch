+std::string str(const char *s) { return s ? s : ""; }
+std::string fullname(const char *p, const char *n) {
+  return p ? str(p) + ":" + str(n) : str(n);
+}
+} // namespace
+std::u16string wide(const std::string &s) {
+  std::u16string r;
+  for (size_t i = 0; i < s.size();) {
+    unsigned long c = (unsigned char)s[i++], n = 0, min = 0;
+    if (c >= 0xc2 && c <= 0xdf) {
+      c &= 31;
+      n = 1;
+      min = 0x80;
+    } else if (c >= 0xe0 && c <= 0xef) {
+      c &= 15;
+      n = 2;
+      min = 0x800;
+    } else if (c >= 0xf0 && c <= 0xf4) {
+      c &= 7;
+      n = 3;
+      min = 0x10000;
+    } else if (c >= 128)
+      throw std::runtime_error("Invalid UTF-8");
+    while (n--) {
+      if (i >= s.size() || ((unsigned char)s[i] & 0xc0) != 0x80)
+        throw std::runtime_error("Invalid UTF-8");
+      c = c * 64 + ((unsigned char)s[i++] & 63);
+    }
+    if (c < min || c > 0x10ffff || (c >= 0xd800 && c <= 0xdfff))
+      throw std::runtime_error("Invalid Unicode scalar");
+    if (c > 0xffff) {
+      c -= 0x10000;
+      r += XMLCh(0xd800 + (c >> 10));
+      r += XMLCh(0xdc00 + (c & 1023));
+    } else
+      r += XMLCh(c);
+  }
+  return r;
+}
+std::string utf8(const XMLCh *s) {
+  std::string r;
+  if (!s)
+    return r;
+  for (size_t i = 0; s[i]; ++i) {
+    unsigned long c = s[i];
+    if (c >= 0xd800 && c <= 0xdbff) {
+      unsigned d = s[++i];
+      if (d < 0xdc00 || d > 0xdfff)
+        throw std::runtime_error("Invalid UTF-16");
+      c = 0x10000 + ((c - 0xd800) << 10) + (d - 0xdc00);
+    } else if (c >= 0xdc00 && c <= 0xdfff)
+      throw std::runtime_error("Invalid UTF-16");
+    if (c < 128)
+      r += char(c);
+    else if (c < 2048) {
+      r += char(192 + (c >> 6));
+      r += char(128 + (c & 63));
+    } else if (c < 65536) {
+      r += char(224 + (c >> 12));
+      r += char(128 + ((c >> 6) & 63));
+      r += char(128 + (c & 63));
+    } else {
+      r += char(240 + (c >> 18));
+      r += char(128 + ((c >> 12) & 63));
+      r += char(128 + ((c >> 6) & 63));
+      r += char(128 + (c & 63));
+    }
+  }
+  return r;
+}
+XMLCh *XMLString::transcode(const char *s) {
+  auto w = wide(s ? s : "");
+  auto *r = new XMLCh[w.size() + 1];
+  std::copy(w.begin(), w.end(), r);
+  r[w.size()] = 0;
+  return r;
+}
+char *XMLString::transcode(const XMLCh *s) {
+  auto t = utf8(s);
+  auto *r = new char[t.size() + 1];
+  std::memcpy(r, t.c_str(), t.size() + 1);
+  return r;
+}
+XMLCh *XMLString::replicate(const XMLCh *s) {
+  auto n = stringLen(s);
+  auto *r = new XMLCh[n + 1];
+  if (n)
+    std::copy(s, s + n, r);
+  r[n] = 0;
+  return r;
+}
+int XMLString::parseInt(const XMLCh *s) {
+  std::string v = utf8(s);
+  if (v.empty())
+    throw XMLException("Missing XML integer");
+  char *end;
+  errno = 0;
+  long x = std::strtol(v.c_str(), &end, 10);
+  while (*end == ' ' || *end == '\t' || *end == '\r' || *end == '\n')
+    ++end;
+  if (errno || *end || x < INT_MIN || x > INT_MAX)
+    throw XMLException("Invalid XML integer: " + v);
+  return int(x);
+}
+XMLDouble::XMLDouble(const XMLCh *s) {
+  std::string v = utf8(s);
+  if (v == "INF")
+    number = HUGE_VAL;
+  else if (v == "-INF")
+    number = -HUGE_VAL;
+  else if (v == "NaN")
+    number = NAN;
+  else {
+    if (v.empty())
+      throw XMLException("Missing XML number");
+    char *end;
+    number = std::strtod(v.c_str(), &end);
+    while (*end == ' ' || *end == '\t' || *end == '\r' || *end == '\n')
+      ++end;
+    if (*end)
+      throw XMLException("Invalid XML number: " + v);
+  }
+}
+XMLSize_t XMLTranscoder::transcodeFrom(const XMLByte *s, XMLSize_t n,
+                                       XMLCh *out, XMLSize_t cap,
+                                       XMLSize_t &eaten, unsigned char *sizes) {
+  auto w = wide(std::string(reinterpret_cast<const char *>(s), n));
+  if (w.size() > cap)
+    throw XMLException("XML transcode buffer too small");
+  std::copy(w.begin(), w.end(), out);
+  if (sizes)
+    std::fill(sizes, sizes + w.size(), 1);
+  eaten = n;
+  return w.size();
+}
+XMLSize_t XMLTranscoder::transcodeTo(const XMLCh *s, XMLSize_t n, XMLByte *out,
+                                     XMLSize_t cap, XMLSize_t &eaten,
+                                     UnRepOpts) {
+  std::u16string w(s, n);
+  auto v = utf8(w.c_str());
+  if (n && s[n - 1] == 0)
+    v += '\0';
+  if (v.size() > cap)
+    throw XMLException("XML transcode buffer too small");
+  std::copy(v.begin(), v.end(), out);
+  eaten = n;
+  return v.size();
+}
