+namespace {
+std::string read(DOMLSInput *in) {
+  if (in->memory)
+    return in->data;
+  if (in->path.find("://") != std::string::npos)
+    throw XMLException("Only mapped local XML resources may be read");
+  std::ifstream f(in->path, std::ios::binary);
+  if (!f)
+    throw XMLException("Cannot open XML resource: " + in->path);
+  return std::string((std::istreambuf_iterator<char>(f)), {});
+}
