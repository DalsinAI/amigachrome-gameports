+/* DOS canonicalizes files and directories alike without changing the caller's
+ * current directory. The legacy chdir/ENOTDIR implementation underallocated
+ * its directory buffer and mishandled native volume paths. */
+char *Realpath(const char *path)
+{
+  BPTR lock;
+  char *resolved=NULL;
+  unsigned long size;
+  LONG error=0;
+  if(!path) { errno=EINVAL;return NULL; }
+  lock=Lock((CONST_STRPTR)path,ACCESS_READ);
+  if(!lock) { errno=ENOENT;return NULL; }
+  for(size=1024;size<=65536;size*=2) {
+    resolved=malloc(size);
+    if(!resolved) { errno=ENOMEM;break; }
+    if(NameFromLock(lock,(STRPTR)resolved,size)) { UnLock(lock);return resolved; }
+    error=IoErr();free(resolved);resolved=NULL;
+    if(error!=ERROR_LINE_TOO_LONG)break;
+  }
+  UnLock(lock);
+  if(error) { SetIoErr(error);errno=error==ERROR_LINE_TOO_LONG?ENAMETOOLONG:EIO; }
+  return NULL;
+}
+#elif defined(__AROS__) || defined(__BEOS__) || defined(__MORPHOS__) || defined(__GP2X__) || defined(__WIZ__) || defined(__CAANOO__) || defined(__amigaos__) || defined(__SWITCH__)
 
