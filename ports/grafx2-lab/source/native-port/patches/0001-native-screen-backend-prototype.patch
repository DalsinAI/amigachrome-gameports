diff --git a/src/amigadatatype.c b/src/amigadatatype.c
new file mode 100644
--- /dev/null
+++ b/src/amigadatatype.c
@@ -0,0 +1,309 @@
+/* GrafX2 native picture DataTypes bridge. GPL-2.0-only.
+ * Uses OS3 picture.datatype V43 methods; OpenPNG/png supplies PNG writes.
+ * Pixel-array methods use DoMethodA, never DoDTMethodA (which replaces word 2).
+ */
+#include <stdlib.h>
+#include <string.h>
+#include <exec/types.h>
+#define timerequest TimeRequest
+#include <datatypes/datatypes.h>
+#include <datatypes/datatypesclass.h>
+#include <datatypes/pictureclass.h>
+#include <proto/exec.h>
+#include <proto/datatypes.h>
+#include <proto/dos.h>
+#include <clib/alib_protos.h>
+#undef timerequest
+#include "global.h"
+#include "loadsave.h"
+#include "io.h"
+#include "screen.h"
+#include "gfx2log.h"
+#ifdef USE_OPENUP
+#include "amigaopenup.h"
+#include <datatypes/openimage.h>
+static struct IntuitionBase *PNGIntuitionBase;
+#define INTUITION_BASE_NAME PNGIntuitionBase
+#include <proto/intuition.h>
+#endif
+struct Library *DataTypesBase;
+static int Open_datatypes(void)
+{
+  if (!DataTypesBase) DataTypesBase = OpenLibrary("datatypes.library", 47);
+  if (!DataTypesBase) DataTypesBase = OpenLibrary("datatypes.library", 45);
+  return DataTypesBase != NULL;
+}
+void GFX2_AmigaDataTypesClose(void)
+{
+#ifdef USE_OPENUP
+  if (PNGIntuitionBase) { CloseLibrary((struct Library *)PNGIntuitionBase); PNGIntuitionBase=NULL; }
+#endif
+  if (DataTypesBase) { CloseLibrary(DataTypesBase); DataTypesBase = NULL; }
+}
+void Test_AmigaPNG(T_IO_Context *context, FILE *file)
+{
+  static const byte sig[8] = {137,80,78,71,13,10,26,10};
+  byte bytes[8];
+  (void)context;
+  File_error = fread(bytes,1,8,file) == 8 && !memcmp(bytes,sig,8) ? 0 : 1;
+}
+void Load_AmigaDataType(T_IO_Context *context)
+{
+  Object *object = NULL;
+  struct BitMapHeader *header = NULL;
+  ULONG *colors = NULL, mode = 0, ncolors = 0;
+  struct pdtBlitPixelArray read = {0};
+  byte *row = NULL;
+  char *path;
+  int width, height, indexed, x, y;
+  long length;
+  File_error = 1;
+  if (!Open_datatypes()) return;
+  path = Filepath_append_to_dir(context->File_directory, context->File_name);
+  if (!path) return;
+  length = File_length(path);
+  object = NewDTObjectA((CONST_STRPTR)path, ((struct TagItem[]) {
+    {DTA_SourceType,DTST_FILE}, {DTA_GroupID,GID_PICTURE},
+    {PDTA_Remap,FALSE}, {PDTA_DestMode,PMODE_V43}, {TAG_DONE,0}}));
+  free(path);
+  if (!object) { GFX2_Log(GFX2_WARNING,"Picture DataType could not open image (IoErr %ld)\n",(long)IoErr());return; }
+  if (!GetDTAttrsA(object,((struct TagItem[]) {{PDTA_BitMapHeader,(ULONG)&header},{TAG_DONE,0}})) || !header) goto done;
+  width = header->bmh_Width; height = header->bmh_Height;
+  if (width < 1 || height < 1 || width > 9999 || height > 9999) goto done;
+  GetDTAttrsA(object,((struct TagItem[]) {
+    {PDTA_CRegs,(ULONG)&colors},{PDTA_ModeID,(ULONG)&mode},
+    {PDTA_NumColors,(ULONG)&ncolors},{TAG_DONE,0}}));
+  /* Keep indexed palette/order when available. HAM/EHB must be decoded as RGB. */
+  indexed = header->bmh_Depth <= 8 && colors && ncolors > 0 && ncolors <= 256 && !(mode & (0x800 | 0x80));
+  row = malloc((size_t)width * 4);
+  if (!row) goto done;
+  read.MethodID = PDTM_READPIXELARRAY;
+  read.pbpa_PixelData = row;
+  read.pbpa_PixelFormat = indexed ? PBPAFMT_LUT8 : PBPAFMT_ARGB;
+  read.pbpa_PixelArrayMod = width * (indexed ? 1 : 4);
+  read.pbpa_Width = width; read.pbpa_Height = 1;
+  /* Probe before allocating/changing the destination document. */
+  if (!DoMethodA(object, (Msg)&read))
+  {
+    indexed = 0;
+    read.pbpa_PixelFormat = PBPAFMT_ARGB;
+    read.pbpa_PixelArrayMod = width * 4;
+    if (!DoMethodA(object, (Msg)&read)) { GFX2_Log(GFX2_WARNING,"Picture DataType has no ARGB pixels (IoErr %ld)\n",(long)IoErr());goto done; }
+  }
+  File_error = 0;
+  Pre_load(context, width, height, length, FORMAT_MISC, PIXEL_SIMPLE, indexed ? 8 : 24);
+  if (File_error) goto done;
+  if (indexed)
+  {
+    for (x=0; x<(int)ncolors; x++)
+    {
+      context->Palette[x].R = colors[x*3] >> 24;
+      context->Palette[x].G = colors[x*3+1] >> 24;
+      context->Palette[x].B = colors[x*3+2] >> 24;
+    }
+    if (header->bmh_Masking == mskHasTransparentColor)
+    { context->Background_transparent = 1; context->Transparent_color = header->bmh_Transparent; }
+  }
+  for (y=0; y<height; y++)
+  {
+    read.pbpa_Top = y;
+    if (y && !DoMethodA(object, (Msg)&read)) { File_error=1; goto done; }
+    for (x=0; x<width; x++)
+      if (indexed) Set_pixel(context,x,y,row[x]);
+      else Set_pixel_24b(context,x,y,row[x*4+1],row[x*4+2],row[x*4+3]);
+  }
+  File_error = 0;
+done:
+  free(row);
+  DisposeDTObject(object);
+}
+static Object *Make_png_object(T_IO_Context *context, const char *writer, byte *row)
+{
+  Object *object;
+  struct BitMapHeader *header = NULL;
+  struct pdtBlitPixelArray write = {0};
+  int x,y;
+#ifdef USE_OPENUP
+  byte table[1024];
+  ULONG stride=((ULONG)context->Width*4+15)&~15UL;
+  byte *block=malloc(stride*32);
+  if (!block) return NULL;
+  for(x=0;x<256;++x) {
+    table[x*4]=context->Background_transparent && x==context->Transparent_color ? 0 : 255;
+    table[x*4+1]=context->Palette[x].R;table[x*4+2]=context->Palette[x].G;table[x*4+3]=context->Palette[x].B;
+  }
+#endif
+  object = NewDTObjectA(NULL,((struct TagItem[]) {{DTA_SourceType,DTST_RAM},
+    {DTA_BaseName,(ULONG)writer},{DTA_GroupID,GID_PICTURE},{TAG_DONE,0}}));
+  if (!object) {
+#ifdef USE_OPENUP
+    free(block);
+#endif
+    return NULL;
+  }
+  if (!GetDTAttrsA(object,((struct TagItem[]) {{PDTA_BitMapHeader,(ULONG)&header},{TAG_DONE,0}})) || !header) goto failed;
+  header->bmh_Width = header->bmh_PageWidth = context->Width;
+  header->bmh_Height = header->bmh_PageHeight = context->Height;
+  header->bmh_Depth = 32;
+  header->bmh_Masking = context->Background_transparent ? mskHasAlpha : mskNone;
+  SetDTAttrsA(object,NULL,NULL,((struct TagItem[]) {
+    {DTA_NominalHoriz,(ULONG)context->Width},{DTA_NominalVert,(ULONG)context->Height},
+    {PDTA_SourceMode,PMODE_V43},
+    {PDTA_AlphaChannel,context->Background_transparent ? TRUE : FALSE},{TAG_DONE,0}}));
+  write.MethodID = PDTM_WRITEPIXELARRAY;
+  write.pbpa_PixelData = row;
+  write.pbpa_PixelFormat = PBPAFMT_ARGB;
+  write.pbpa_PixelArrayMod = context->Width*4;
+  write.pbpa_Width = context->Width; write.pbpa_Height = 1;
+  for(y=0;y<context->Height;y++)
+  {
+#ifdef USE_OPENUP
+    if ((y&31)==0) {
+      ULONG rows=context->Height-y; if(rows>32)rows=32;
+      GFX2_OpenUpExpand(context->Target_address+y*context->Pitch,context->Pitch,block,stride,context->Width,rows,table);
+    }
+    write.pbpa_PixelData=block+(y&31)*stride;
+    write.pbpa_PixelArrayMod=stride;
+#else
+    for(x=0;x<context->Width;x++)
+    {
+      byte index=Get_pixel(context,x,y);
+      row[x*4] = context->Background_transparent && index==context->Transparent_color ? 0 : 255;
+      row[x*4+1]=context->Palette[index].R;
+      row[x*4+2]=context->Palette[index].G;
+      row[x*4+3]=context->Palette[index].B;
+    }
+    #endif
+    write.pbpa_Top=y;
+    if (!DoMethodA(object,(Msg)&write)) goto failed;
+  }
+  #ifdef USE_OPENUP
+  free(block);
+  #endif
+  return object;
+failed:
+  #ifdef USE_OPENUP
+  free(block);
+  #endif
+  DisposeDTObject(object);
+  return NULL;
+}
+#ifdef USE_OPENUP
+/* OpenPNG's public encoder takes our ARGB pixels directly. This avoids an
+ * extra picture.datatype image and readback, and works without depending on
+ * the superclass's RAM-picture storage implementation. */
+static int Save_openpng(T_IO_Context *context, const char *temp)
+{
+  struct Library *png=NULL;
+  Object *object=NULL;
+  struct oiEncodePNG encode={0};
+  byte *pixels=NULL,table[1024];
+  ULONG stride,y,rows;
+  int x,saved=0;
+  FILE *file=NULL;
+  if(context->Width>9999 || context->Height>9999 || !context->Target_address) return 0;
+  png=OpenLibrary("datatypes/openpng.datatype",47);
+  if(!png || (png->lib_Version==47 && png->lib_Revision<4)) { GFX2_Log(GFX2_WARNING,"OpenPNG encoder unavailable (base %p, IoErr %ld)\n",png,(long)IoErr());goto done; }
+  if(!PNGIntuitionBase) PNGIntuitionBase=(struct IntuitionBase *)OpenLibrary("intuition.library",39);
+  if(!PNGIntuitionBase) goto done;
+  object=NewObjectA(NULL,(CONST_STRPTR)"openpng.datatype",((struct TagItem[]){{DTA_SourceType,DTST_RAM},{TAG_DONE,0}}));
+  if(!object) { GFX2_Log(GFX2_WARNING,"OpenPNG: cannot create encoder (IoErr %ld)\n",(long)IoErr());goto done; }
+  stride=((ULONG)context->Width*4+15)&~15UL;
+  pixels=malloc(stride*context->Height);if(!pixels)goto done;
+  for(x=0;x<256;++x) {
+    table[x*4]=context->Background_transparent && x==context->Transparent_color ? 0 : 255;
+    table[x*4+1]=context->Palette[x].R;table[x*4+2]=context->Palette[x].G;table[x*4+3]=context->Palette[x].B;
+  }
+  for(y=0;y<(ULONG)context->Height;y+=rows) {
+    rows=context->Height-y;if(rows>32)rows=32;
+    GFX2_OpenUpExpand(context->Target_address+y*context->Pitch,context->Pitch,pixels+y*stride,stride,context->Width,rows,table);
+  }
+  encode.MethodID=OIM_ENCODEPNG;encode.oiep_Pixels=pixels;
+  encode.oiep_Width=context->Width;encode.oiep_Height=context->Height;
+  encode.oiep_Stride=stride;encode.oiep_Level=-1;
+  if(!context->Background_transparent)encode.oiep_Flags=OIEF_OPAQUE;
+  if(!DoMethodA(object,(Msg)&encode)) {
+    GFX2_Log(GFX2_WARNING,"OpenPNG: encoding failed (error %ld)\n",(long)encode.oiep_Error);goto done;
+  }
+  if(!encode.oiep_Data || encode.oiep_Size<8 || memcmp(encode.oiep_Data,"\211PNG\r\n\032\n",8))goto done;
+  file=fopen(temp,"wb");if(!file)goto done;
+  saved=fwrite(encode.oiep_Data,1,encode.oiep_Size,file)==encode.oiep_Size;
+  if(fclose(file))saved=0;
+  file=NULL;
+done:
+  if(file)fclose(file);
+  if(encode.oiep_Data)FreeVec(encode.oiep_Data);
+  free(pixels);
+  if(object)DisposeObject(object);
+  if(png)CloseLibrary(png);
+  if(!saved)DeleteFile((CONST_STRPTR)temp);
+  return saved;
+}
+#endif
+void Save_AmigaPNG(T_IO_Context *context)
+{
+  static const char *writers[] = {"openpng", "png"};
+  static unsigned long serial;
+  byte *row = NULL;
+  char *path = NULL, *temp = NULL, *backup = NULL;
+  unsigned writer;
+  BPTR lock;
+  int saved = 0, attempted = 0, had_original = 0;
+  File_error = 1;
+  if (!Open_datatypes() || context->Width < 1 || context->Height < 1) goto done;
+  path=Filepath_append_to_dir(context->File_directory,context->File_name);
+  if (!path) goto done;
+  temp=malloc(strlen(path)+64); backup=malloc(strlen(path)+64);
+  row=malloc((size_t)context->Width*4);
+  if (!temp || !backup || !row) goto done;
+  snprintf(temp,strlen(path)+64,"%s.gfx2-%08lx-%lu.tmp",path,(unsigned long)FindTask(NULL),++serial);
+  snprintf(backup,strlen(path)+64,"%s.gfx2-%08lx-%lu.bak",path,(unsigned long)FindTask(NULL),serial);
+  /* Never reuse a surviving file from an earlier process. */
+  lock=Lock((CONST_STRPTR)temp,ACCESS_READ); if(lock) {UnLock(lock);goto done;}
+  lock=Lock((CONST_STRPTR)backup,ACCESS_READ); if(lock) {UnLock(lock);goto done;}
+  #ifdef USE_OPENUP
+  saved=Save_openpng(context,temp);
+  if(saved)attempted=1;
+  #endif
+  for(writer=0;!saved && writer<sizeof(writers)/sizeof(writers[0]);writer++)
+  {
+    Object *object=Make_png_object(context,writers[writer],row);
+    if(!object) continue;
+    attempted=1;
+    saved=SaveDTObjectA(object,NULL,NULL,(CONST_STRPTR)temp,DTWM_RAW,FALSE,NULL)!=0;
+    DisposeDTObject(object);
+    if(saved)
+    {
+      static const byte signature[8]={137,80,78,71,13,10,26,10};
+      byte bytes[8];
+      FILE *probe=fopen(temp,"rb");
+      saved=probe && fread(bytes,1,8,probe)==8 && !memcmp(bytes,signature,8);
+      if(probe) fclose(probe);
+    }
+    if(saved) break;
+    DeleteFile((CONST_STRPTR)temp);
+  }
+  if (!saved) goto done;
+  lock=Lock((CONST_STRPTR)path,ACCESS_READ);
+  if(lock)
+  {
+    UnLock(lock);
+    if(!Rename((CONST_STRPTR)path,(CONST_STRPTR)backup)) goto done;
+    had_original=1;
+  }
+  if(Rename((CONST_STRPTR)temp,(CONST_STRPTR)path))
+  {
+    File_error=0;
+    if(had_original) DeleteFile((CONST_STRPTR)backup);
+  }
+  else if(had_original && !Rename((CONST_STRPTR)backup,(CONST_STRPTR)path))
+    GFX2_MessageBox("Save failed. The original file is retained under its .gfx2-*.bak name.","GrafX2",GFX2_MB_ERROR);
+done:
+  if(attempted && temp) DeleteFile((CONST_STRPTR)temp);
+  free(path);free(temp);free(backup);free(row);
+  if(File_error)
+  {
+    GFX2_Log(GFX2_WARNING,"PNG save failed: check disk space, permissions and OpenPNG 47.4+ or another PNG writer.\n");
+    GFX2_MessageBox("PNG could not be saved. Check disk space and permissions. PNG output needs OpenPNG 47.4 or another PNG datatype with write support. GIF and IFF remain available.","GrafX2",GFX2_MB_ERROR);
+  }
+}
diff --git a/src/amigaexpand.c b/src/amigaexpand.c
new file mode 100644
--- /dev/null
+++ b/src/amigaexpand.c
@@ -0,0 +1,14 @@
+/* Pure worker: no OS, globals, allocation, or library calls. GPL-2.0-only. */
+#include "amigaopenup.h"
+__attribute__((noinline)) LONG GFX2_ExpandRow(ULONG y, const UBYTE *in, UBYTE *out,
+ const UBYTE *table, ULONG width, ULONG ipitch, ULONG opitch)
+{
+  const UBYTE *s = in + y * ipitch;
+  UBYTE *d = out + y * opitch;
+  ULONG x;
+  for (x=0; x<width; ++x) {
+    const UBYTE *p = table + (ULONG)s[x] * 4;
+    d[0]=p[0]; d[1]=p[1]; d[2]=p[2]; d[3]=p[3]; d+=4;
+  }
+  return 0;
+}
diff --git a/src/amigafont.c b/src/amigafont.c
new file mode 100644
--- /dev/null
+++ b/src/amigafont.c
@@ -0,0 +1,103 @@
+/* OpenFont -> GrafX2 indexed text brush. GPL-2.0-only. */
+#include <stdlib.h>
+#include <string.h>
+#include <limits.h>
+#include <proto/openfont.h>
+#include "global.h"
+#include "misc.h"
+#include "windows.h"
+#include "amigaopenup.h"
+
+struct BrushGlyph { struct OFBitmap bitmap; LONG x,y; };
+static LONG pixel_floor(LONG x) { return x>=0 ? x/64 : -((-x+63)/64); }
+/* GrafX2's classic text field is Latin-1, as SDL_ttf RenderText was. */
+static char *to_utf8(const char *s)
+{
+  size_t i,n=strlen(s),p=0; char *out;
+  if(n>4096) return NULL;
+  out=malloc(n*2+1);if(!out)return NULL;
+  for(i=0;i<n;++i) { unsigned char c=(unsigned char)s[i];
+    if(c>=128) { out[p++]=0xc0|(c>>6);out[p++]=0x80|(c&63); } else out[p++]=c;
+  }
+  out[p]=0;return out;
+}
+byte *GFX2_OpenFontRender(const char *str,const char *path,int size,int aa,int bold,int italic,
+ int *width,int *height,T_Palette palette)
+{
+  struct OFFace *face=NULL;
+  struct OFFaceInfo info;
+  struct OFGlyph *shape=NULL;
+  struct BrushGlyph *glyphs=NULL;
+  char *text=NULL,*line,*next;
+  byte *brush=NULL;
+  ULONG count=0,used=0,i,x,y;
+  LONG baseline=0,lineheight,left=0,top=0,right=0,bottom=0,w,h;
+  LONG penx=0,peny=0;
+  if(!str || !path || !width || !height || size<1 || size>512 || !GFX2_OpenUpFontAvailable()) return NULL;
+  text=to_utf8(str);if(!text)return NULL;
+  face=OF_OpenFaceA((CONST_STRPTR)path,((struct TagItem[]){{OFA_Size,(ULONG)size},{TAG_DONE,0}}));
+  if(!face || OF_GetFaceInfo(face,&info)!=0) goto done;
+  lineheight=(info.fi_Height+63)/64;if(lineheight<1)lineheight=size;
+  baseline=(info.fi_Ascender+63)/64;
+  /* Shaping each line twice measures capacity then fills; no fixed glyph limit. */
+  for(line=text;line;) {
+    next=strchr(line,'\n');if(next)*next=0;
+    count+=OF_ShapeText(face,(CONST_STRPTR)line,strlen(line),NULL,0);
+    if(next)*next='\n';line=next?next+1:NULL;
+  }
+  if(count>16384)goto done;
+  shape=calloc(count?count:1,sizeof(*shape));glyphs=calloc(count?count:1,sizeof(*glyphs));
+  if(!shape || !glyphs)goto done;
+  for(line=text;line;) {
+    ULONG n;
+    next=strchr(line,'\n');if(next)*next=0;
+    n=OF_ShapeText(face,(CONST_STRPTR)line,strlen(line),shape,count);
+    if(*line && !n)goto done;
+    if(n>count || used+n>count)goto done;
+    penx=peny=0;
+    for(i=0;i<n;++i) {
+      struct BrushGlyph *g=&glyphs[used++];
+      struct OFFace *gf=OF_GetFallback(face,shape[i].gl_Face);
+      if(!gf || OF_RasterGlyph(gf,shape[i].gl_Glyph,&g->bitmap)!=0)goto done;
+      g->x=pixel_floor(penx+shape[i].gl_XOffset)+g->bitmap.bm_Left;
+      g->y=baseline-pixel_floor(peny+shape[i].gl_YOffset)-g->bitmap.bm_Top;
+      if(g->x<left)left=g->x;if(g->y<top)top=g->y;
+      /* Synthetic bold and oblique are applied to the brush, never to font state. */
+      if(g->x+(LONG)g->bitmap.bm_Width+(bold?1:0)+(italic?(LONG)g->bitmap.bm_Height/4+1:0)>right)
+        right=g->x+g->bitmap.bm_Width+(bold?1:0)+(italic?g->bitmap.bm_Height/4+1:0);
+      if(g->y+(LONG)g->bitmap.bm_Height>bottom)bottom=g->y+g->bitmap.bm_Height;
+      penx+=shape[i].gl_XAdvance;peny+=shape[i].gl_YAdvance;
+    }
+    if(pixel_floor(penx+63)>right)right=pixel_floor(penx+63);
+    if(baseline-(info.fi_Descender/64)>bottom)bottom=baseline-info.fi_Descender/64;
+    baseline+=lineheight;line=next?next+1:NULL;
+  }
+  w=right-left;h=bottom-top;if(w<1)w=1;if(h<1)h=lineheight;
+  if(w>9999 || h>9999 || (unsigned long)w*h>32UL*1024*1024)goto done;
+  brush=calloc((size_t)w,h);if(!brush)goto done;
+  for(i=0;i<used;++i) {
+    struct BrushGlyph *g=&glyphs[i];struct OFBitmap *b=&g->bitmap;
+    for(y=0;y<b->bm_Height;++y)for(x=0;x<b->bm_Width;++x) {
+      LONG dx=g->x-left+x+(italic?(b->bm_Height-1-y)/4:0),dy=g->y-top+y;
+      byte a=b->bm_Pixels[y*b->bm_Stride+x];
+      if(dx>=0 && dx<w && dy>=0 && dy<h) {
+        byte *d=brush+dy*w+dx;if(*d<a)*d=a;
+        if(bold && dx+1<w && d[1]<a)d[1]=a;
+      }
+    }
+  }
+  if(aa) {
+    for(i=0;i<256;++i)palette[i].R=palette[i].G=palette[i].B=i;
+    palette[0]=palette[Back_color];palette[Back_color]=Main.palette[Back_color];
+    for(i=0;i<(ULONG)w*h;++i) { if(brush[i]==0)brush[i]=Back_color;else if(brush[i]==Back_color)brush[i]=0; }
+  } else {
+    byte fg=Fore_color;
+    if(fg==Back_color)fg=Best_color_perceptual_except(Main.palette[Back_color].R,Main.palette[Back_color].G,Main.palette[Back_color].B,Back_color);
+    memcpy(palette,Main.palette,sizeof(T_Palette));
+    for(i=0;i<(ULONG)w*h;++i)brush[i]=brush[i]>=128?fg:Back_color;
+  }
+  *width=w;*height=h;
+done:
+  if(glyphs)for(i=0;i<used;++i)OF_FreeBitmap(&glyphs[i].bitmap);
+  free(glyphs);free(shape);if(face)OF_CloseFace(face);free(text);return brush;
+}
diff --git a/src/amigafpu.c b/src/amigafpu.c
new file mode 100644
--- /dev/null
+++ b/src/amigafpu.c
@@ -0,0 +1,19 @@
+/* GPL-2.0-only. libnix hard-FPU startup compatibility for native 68040 AROS.
+ * AROS correctly advertises AFF_FPU40 without also setting AFF_68881.
+ * The open3 libm881 startup check accepts only AFF_68881. Override that
+ * check, retaining FPCR round-to-nearest setup and refusal without an FPU.
+ */
+#include <exec/execbase.h>
+#include <proto/exec.h>
+void __fpucheck(void)
+{
+  ULONG fpcr;
+  if (!(SysBase->AttnFlags & (AFF_68881 | AFF_68882 | AFF_FPU40)))
+  {
+    Alert(0x00068881);
+    for (;;) { }
+  }
+  __asm__ volatile ("fmove.l %%fpcr,%0" : "=d"(fpcr));
+  fpcr &= ~0x30UL;
+  __asm__ volatile ("fmove.l %0,%%fpcr" : : "d"(fpcr));
+}
diff --git a/src/amigainput.inc b/src/amigainput.inc
new file mode 100644
--- /dev/null
+++ b/src/amigainput.inc
@@ -0,0 +1,99 @@
+/* Included inside Get_input(), GPL-2.0-only. */
+    struct Window *window = GFX2_AmigaNativeWindow();
+    struct IntuiMessage *message;
+    int feedback = 0;
+    Key = Key_ANSI = Key_UNICODE = 0;
+    Mouse_moved = 0;
+    Input_new_mouse_X = Mouse_X;
+    Input_new_mouse_Y = Mouse_Y;
+    Input_new_mouse_K = Mouse_K;
+    Color_cycling();
+    Flush_update();
+    if (Quit_is_required) return 1;
+    if (!window) { Quit_is_required = 1; return 1; }
+    while (!feedback && (message = (struct IntuiMessage *)GetMsg(window->UserPort)))
+    {
+      ULONG event_class = message->Class;
+      UWORD code = message->Code;
+      UWORD qualifier = message->Qualifier;
+      WORD x = message->MouseX, y = message->MouseY;
+      /* Never retain an IntuiMessage beyond ReplyMsg. */
+      ReplyMsg((struct Message *)message);
+      word previous_modifiers = Amiga_key_modifiers;
+      Amiga_key_modifiers = Amiga_modifiers(qualifier);
+      switch(event_class)
+      {
+        case IDCMP_MOUSEMOVE:
+          feedback = Move_cursor_with_constraints(x / Pixel_width / render_scale_x,
+                                                   y / Pixel_height / render_scale_y);
+          break;
+        case IDCMP_MOUSEBUTTONS:
+        {
+          byte mask = 0;
+          if ((code & ~IECODE_UP_PREFIX) == IECODE_LBUTTON) mask = Button_inverter ? 2 : 1;
+          if ((code & ~IECODE_UP_PREFIX) == IECODE_RBUTTON) mask = Button_inverter ? 1 : 2;
+          if (mask)
+          {
+            if (code & IECODE_UP_PREFIX) Input_new_mouse_K &= ~mask;
+            else Input_new_mouse_K |= mask;
+            feedback = Handle_mouse_btn_change();
+          }
+          else if (code == IECODE_MBUTTON)
+          { Key = KEY_MOUSEMIDDLE | Amiga_key_modifiers; feedback = 1; }
+          break;
+        }
+        case IDCMP_RAWKEY:
+        {
+          word text;
+          word key = Amiga_key(code & ~IECODE_UP_PREFIX, qualifier, &text);
+          word released = previous_modifiers & ~Amiga_key_modifiers;
+          if (code & IECODE_UP_PREFIX)
+            feedback = Release_control(key, released);
+          else
+          {
+            word pressed = Amiga_key_modifiers & ~previous_modifiers;
+            if (Config.Swap_buttons && pressed == Config.Swap_buttons && !Button_inverter)
+            {
+              Button_inverter = 1;
+              if (Input_new_mouse_K) { Input_new_mouse_K ^= 3; feedback = Handle_mouse_btn_change(); }
+            }
+            if (key)
+            {
+              Key = key | Amiga_key_modifiers;
+              Key_ANSI = Key_UNICODE = text;
+              Handle_special_key_press();
+              feedback = 1;
+            }
+          }
+          break;
+        }
+        case IDCMP_INACTIVEWINDOW:
+          Amiga_key_modifiers = 0;
+          Input_new_mouse_K = 0;
+          Button_inverter = 0;
+          Directional_emulated = Directional_click = 0;
+          Pan_shortcut_pressed = 0;
+          feedback = Handle_mouse_btn_change();
+          break;
+        case IDCMP_REFRESHWINDOW:
+          BeginRefresh(window);
+          Update_rect(0, 0, 0, 0);
+          Flush_update();
+          EndRefresh(window, TRUE);
+          feedback = 1;
+          break;
+        case IDCMP_CLOSEWINDOW:
+          Quit_is_required = 1;
+          feedback = 1;
+          break;
+      }
+    }
+    Mouse_Emulation();
+    if (Mouse_moved)
+    {
+      Compute_paintbrush_coordinates();
+      Display_cursor();
+      return 1;
+    }
+    if (feedback) return 1;
+    if (sleep_time > 0) Delay((sleep_time + 19) / 20);
diff --git a/src/amigakeys.h b/src/amigakeys.h
new file mode 100644
--- /dev/null
+++ b/src/amigakeys.h
@@ -0,0 +1,65 @@
+/* Native raw-key to GrafX2 key namespace, GPL-2.0-only. */
+#include "keycodes.h"
+static word Amiga_modifiers(UWORD q)
+{
+  return ((q & (IEQUALIFIER_LSHIFT|IEQUALIFIER_RSHIFT)) ? GFX2_MOD_SHIFT : 0)
+       | ((q & IEQUALIFIER_CONTROL) ? GFX2_MOD_CTRL : 0)
+       | ((q & (IEQUALIFIER_LALT|IEQUALIFIER_RALT)) ? GFX2_MOD_ALT : 0)
+       | ((q & (IEQUALIFIER_LCOMMAND|IEQUALIFIER_RCOMMAND)) ? GFX2_MOD_META : 0);
+}
+static word Amiga_key(UWORD raw, UWORD qualifier, word *text)
+{
+  struct InputEvent ie = {0};
+  char chars[8];
+  LONG count;
+  *text = 0;
+  ie.ie_Class = IECLASS_RAWKEY;
+  ie.ie_Code = raw;
+  ie.ie_Qualifier = qualifier;
+  count = MapRawKey(&ie, chars, sizeof(chars), NULL);
+  if (count == 1) *text = (unsigned char)chars[0];
+  if (raw >= 0x50 && raw <= 0x59) return KEY_F1 + raw - 0x50;
+  switch(raw)
+  {
+    case 0x40: return KEY_SPACE;
+    case 0x41: return KEY_BACKSPACE;
+    case 0x42: return KEY_TAB;
+    case 0x43: return KEY_KP_ENTER;
+    case 0x44: return KEY_RETURN;
+    case 0x45: return KEY_ESCAPE;
+    case 0x46: return KEY_DELETE;
+    case 0x4c: return KEY_UP;
+    case 0x4d: return KEY_DOWN;
+    case 0x4e: return KEY_RIGHT;
+    case 0x4f: return KEY_LEFT;
+    case 0x60: return KEY_LSHIFT;
+    case 0x61: return KEY_RSHIFT;
+    case 0x62: return KEY_CAPSLOCK;
+    case 0x63: return KEY_LCTRL;
+    case 0x64: return KEY_LALT;
+    case 0x65: return KEY_RALT;
+    case 0x5f: return KEY_F1; /* Help */
+    case 0x3d: return KEY_KP7;
+    case 0x3e: return KEY_KP8;
+    case 0x3f: return KEY_KP9;
+    case 0x2d: return KEY_KP4;
+    case 0x2e: return KEY_KP5;
+    case 0x2f: return KEY_KP6;
+    case 0x1d: return KEY_KP1;
+    case 0x1e: return KEY_KP2;
+    case 0x1f: return KEY_KP3;
+    case 0x0f: return KEY_KP0;
+    case 0x3c: return KEY_KP_PERIOD;
+    case 0x4a: return KEY_KP_MINUS;
+    case 0x5e: return KEY_KP_PLUS;
+    case 0x5c: return KEY_KP_DIVIDE;
+    case 0x5d: return KEY_KP_MULTIPLY;
+    case 0x7a: return KEY_MOUSEWHEELUP;
+    case 0x7b: return KEY_MOUSEWHEELDOWN;
+  }
+  /* Translate shortcuts without Shift/Control/Alt, text with full qualifiers. */
+  ie.ie_Qualifier = 0;
+  count = MapRawKey(&ie, chars, sizeof(chars), NULL);
+  if (count == 1) return (unsigned char)chars[0];
+  return 0;
+}
diff --git a/src/amigaopenup.c b/src/amigaopenup.c
new file mode 100644
--- /dev/null
+++ b/src/amigaopenup.c
@@ -0,0 +1,123 @@
+/* Native OpenUp services for GrafX2. GPL-2.0-only. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <dos/dosextens.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/openrtg.h>
+#include <proto/opengpu.h>
+#include <proto/openmulticore.h>
+#include <proto/openfont.h>
+#include "amigaopenup.h"
+#include "zlibrary.h"
+
+struct Library *OpenRTGBase, *OpenGPUBase, *OpenMulticoreBase, *OpenFontBase;
+static struct Library *ZBase;
+static int Initialized;
+static ULONG Presents, Fallbacks, Ranges, RangeFallbacks;
+static int at_least(struct Library *b, UWORD v, UWORD r)
+{ return b && (b->lib_Version>v || (b->lib_Version==v && b->lib_Revision>=r)); }
+static int enabled(const char *name)
+{ char value[8]; LONG n=GetVar((CONST_STRPTR)name,(STRPTR)value,sizeof(value),0); return n!=1 || value[0]!='0'; }
+void GFX2_OpenUpInit(void)
+{
+  if (Initialized) return;
+  Initialized=1;
+  if (enabled("GRAFX2_OPENRTG")) OpenRTGBase=OpenLibrary("openrtg.library",0);
+  if (OpenRTGBase && !at_least(OpenRTGBase,0,4)) { CloseLibrary(OpenRTGBase); OpenRTGBase=NULL; }
+  OpenGPUBase=OpenLibrary(OPENGPU_NAME,0);
+  if (enabled("GRAFX2_OPENFONT")) OpenFontBase=OpenLibrary(OPENFONTNAME,OPENFONT_VERSION);
+  if (enabled("GRAFX2_OPENMULTICORE")) OpenMulticoreBase=OpenLibrary(OPENMULTICORE_NAME,0);
+  if (OpenMulticoreBase && !OMC_HAS_RANGE(OpenMulticoreBase)) { CloseLibrary(OpenMulticoreBase); OpenMulticoreBase=NULL; }
+  ZBase=OpenLibrary(ZL_NAME,ZL_VERSION);
+  fprintf(stderr,"OpenUp: OpenRTG=%s OpenFont=%s OpenMulticore=%s OpenZlib=%s\n",
+    OpenRTGBase?"available":"absent/old",OpenFontBase?"available":"absent",
+    OpenMulticoreBase?"available":"absent/old",ZBase?"available":"absent");
+  if (OpenGPUBase) {
+    ULONG q=OGPU_Query(OGPU_OP_PIXELS,OGPU_FMT_CLUT8);
+    fprintf(stderr,"OpenGPU: indexed upload support=%d backend=%d hardware-GPU=%d\n",
+      OGPU_ANSWER(q),OGPU_BACKEND(q),OGPU_ONGPU(q));
+  }
+}
+int GFX2_OpenUpFontAvailable(void) { GFX2_OpenUpInit(); return OpenFontBase!=NULL; }
+int GFX2_OpenUpPresent(struct RastPort *rp, UBYTE *pixels, ULONG pitch,
+ LONG x, LONG y, LONG width, LONG height)
+{
+  struct OpenRTGPixels p={0};
+  if (!OpenRTGBase) { ++Fallbacks; return 0; }
+  p.data=pixels; p.x=x; p.y=y; p.modulo=pitch; p.format=ORTG_PIX_PEN;
+  p.width=width; p.height=height;
+  /* OpenRTG owns clipping, bitmap recognition, and GPU fences/source lifetime. */
+  if (ORTG_WritePixels(rp,x,y,&p)!=width*height) { ++Fallbacks; return 0; }
+  ++Presents; return 1;
+}
+void GFX2_OpenUpExpand(const UBYTE *in, ULONG ipitch, UBYTE *out, ULONG opitch,
+ ULONG width, ULONG rows, const UBYTE *table)
+{
+  struct OMCJob job;
+  struct Process *process;
+  struct CommandLineInterface *cli;
+  UBYTE *input=NULL,*output=NULL;
+  ULONG args[6],failed=0,y;
+  int ok=0;
+  /* Copy only sizeable blocks into grants; never expose editor memory to workers. */
+  if (OpenMulticoreBase && width*rows>=16384 && (opitch&15)==0) {
+    process=(struct Process *)FindTask(NULL);
+    cli=process->pr_CLI ? (struct CommandLineInterface *)BADDR(process->pr_CLI) : NULL;
+    if (cli && cli->cli_Module) {
+      input=OMC_AllocGrant(1024+width*rows,OMCAF_PAGE);
+      output=OMC_AllocGrant(opitch*rows,OMCAF_PAGE);
+      if (input && output) {
+        memcpy(input,table,1024);
+        for(y=0;y<rows;++y) memcpy(input+1024+y*width,in+y*ipitch,width);
+        OMC_JobInit(&job);
+        job.omj_Entry=(APTR)GFX2_ExpandRow;
+        args[0]=(ULONG)(input+1024);args[1]=(ULONG)output;args[2]=(ULONG)input;
+        args[3]=width;args[4]=width;args[5]=opitch;
+        job.omj_Args=args;job.omj_NArgs=6;job.omj_Flags=OMCF_STRICT;
+        if (OMC_AddGrant(&job,input,1024+width*rows,OMCG_READ)==OMCERR_OK &&
+            OMC_AddGrant(&job,output,opitch*rows,OMCG_WRITE)==OMCERR_OK &&
+            OMC_GrantSeg(&job,cli->cli_Module,OMCG_READ|OMCG_EXEC)>0 &&
+            OMC_RunRange(&job,rows,opitch,&failed)==OMCERR_OK && failed==rows) {
+          for(y=0;y<rows;++y) memcpy(out+y*opitch,output+y*opitch,width*4);
+          ok=1; ++Ranges;
+        } else { ++RangeFallbacks;fprintf(stderr,"OpenMulticore range fallback: status=%ld failed=%lu where=%lu fault=%lu\n",(long)job.omj_Status,(unsigned long)failed,(unsigned long)job.omj_Where,(unsigned long)job.omj_FaultVector); }
+      }
+      if (output) OMC_FreeGrant(output);
+      if (input) OMC_FreeGrant(input);
+    }
+  }
+  if (!ok) for(y=0;y<rows;++y) GFX2_ExpandRow(y,in,out,table,width,ipitch,opitch);
+}
+int GFX2_OpenZUncompress(UBYTE *dst, unsigned long *length, const UBYTE *src, unsigned long bytes)
+{
+  struct zl_stream s={0}; LONG r;
+  GFX2_OpenUpInit();
+  if (!ZBase) return ZL_STREAM_ERROR;
+  s.next_in=src;s.avail_in=bytes;s.next_out=dst;s.avail_out=*length;
+  r=zl_InflateInit2(ZBase,&s,15); if (r!=ZL_OK) return r;
+  r=zl_Inflate(ZBase,&s,ZL_FINISH);
+  *length=s.total_out;
+  zl_InflateEnd(ZBase,&s);
+  return r==ZL_STREAM_END ? ZL_OK : r==ZL_OK ? ZL_BUF_ERROR : r;
+}
+const char *GFX2_OpenZError(int code)
+{
+  if (!ZBase) return "z.library V53 required (OpenZlib)";
+  switch(code) { case 0:return "OK";case -3:return "invalid compressed data";
+    case -4:return "out of memory";case -5:return "output buffer full or truncated stream";
+    default:return "OpenZlib stream error"; }
+}
+void GFX2_OpenUpClose(void)
+{
+  if (!Initialized) return;
+  fprintf(stderr,"OpenUp: presentations=%lu native-fallbacks=%lu conversion-ranges=%lu range-failures=%lu\n",
+    Presents,Fallbacks,Ranges,RangeFallbacks);
+  if (ZBase) { CloseLibrary(ZBase);ZBase=NULL; }
+  if (OpenFontBase) { CloseLibrary(OpenFontBase);OpenFontBase=NULL; }
+  if (OpenMulticoreBase) { CloseLibrary(OpenMulticoreBase);OpenMulticoreBase=NULL; }
+  if (OpenGPUBase) { CloseLibrary(OpenGPUBase);OpenGPUBase=NULL; }
+  if (OpenRTGBase) { CloseLibrary(OpenRTGBase);OpenRTGBase=NULL; }
+  Initialized=0;
+}
diff --git a/src/amigaopenup.h b/src/amigaopenup.h
new file mode 100644
--- /dev/null
+++ b/src/amigaopenup.h
@@ -0,0 +1,15 @@
+/* GrafX2 OpenUp integration, GPL-2.0-only. */
+#ifndef GFX2_AMIGAOPENUP_H
