+/* Sleep until the window has input or ms milliseconds pass. The editor's main
+ * loop polls with no sleep; without this it presents continuously while idle. */
+void GFX2_AmigaIdleWait(ULONG ms)
+{
+  ULONG window_signal = 0, timer_signal;
+  if (Native_window && Native_window->UserPort)
+    window_signal = 1UL << Native_window->UserPort->mp_SigBit;
+  if (!Idle_open)
+  {
+    if (!Idle_port) Idle_port = CreateMsgPort();
+    if (Idle_port && !Idle_request)
+      Idle_request = (struct TimeRequest *)CreateIORequest(Idle_port, sizeof(struct TimeRequest));
+    if (Idle_request && OpenDevice((CONST_STRPTR)TIMERNAME, UNIT_MICROHZ, (struct IORequest *)Idle_request, 0) == 0)
+      Idle_open = 1;
+    if (!Idle_open) { Delay((ms + 19) / 20); return; }
+  }
+  timer_signal = 1UL << Idle_port->mp_SigBit;
+  Idle_request->tr_node.io_Command = TR_ADDREQUEST;
+  Idle_request->tr_time.tv_secs = ms / 1000;
+  Idle_request->tr_time.tv_micro = (ms % 1000) * 1000;
+  SetSignal(0, timer_signal);
+  SendIO((struct IORequest *)Idle_request);
+  Wait(window_signal | timer_signal);
+  if (!CheckIO((struct IORequest *)Idle_request)) AbortIO((struct IORequest *)Idle_request);
+  WaitIO((struct IORequest *)Idle_request);
+}
+
 extern void GFX2_AmigaDataTypesClose(void);
 void GFX2_AmigaClose(void)
 {
   GFX2_AmigaDataTypesClose();
   Close_native_display();
+  if (Idle_open) { CloseDevice((struct IORequest *)Idle_request); Idle_open = 0; }
+  if (Idle_request) { DeleteIORequest((struct IORequest *)Idle_request); Idle_request = NULL; }
+  if (Idle_port) { DeleteMsgPort(Idle_port); Idle_port = NULL; }
   #ifdef USE_OPENUP
   GFX2_OpenUpClose();
   #endif
