diff --git a/LIB386/PLATFORM/CMakeLists.txt b/LIB386/PLATFORM/CMakeLists.txt
index 08d7121..b3f2513 100644
--- a/LIB386/PLATFORM/CMakeLists.txt
+++ b/LIB386/PLATFORM/CMakeLists.txt
@@ -82,7 +82,14 @@ if(PLATFORM_BACKEND STREQUAL "null")
     return()
 endif()
 
-if(ANDROID)
+option(LBA2_OPENAMIGA_SDL3 "Use the OpenGPU SDL3 module client" OFF)
+if(LBA2_OPENAMIGA_SDL3)
+    if(NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "m68k" OR LBA2_LINK_STATIC)
+        message(FATAL_ERROR "OpenAmiga SDL3 requires m68k and the module client, not private static SDL")
+    endif()
+    find_package(SDL3 REQUIRED CONFIG)
+    set(_SDL3_TARGET SDL3::SDL3)
+elseif(ANDROID)
     find_package(SDL3 REQUIRED CONFIG)
     set(_SDL3_TARGET SDL3::SDL3)
 elseif(LBA2_LINK_STATIC)
