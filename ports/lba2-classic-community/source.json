        "-DLBA2_LINK_STATIC=OFF",
        "-DLBA2_BUILD_SAVE_TOOLS=OFF",
        "-DLBA2_BUILD_TESTS=OFF",
        "-DLBA2_CONTROL_SERVER=OFF",
        "-DLBA2_NATIVE_ARCH=OFF",
        "-DLBA2_ENABLE_IPO=OFF",
        "-DLBA2_OPENAMIGA_MATH_SOURCE=@PORT_DIR@/compat/lrintl.c"
      ]
    }
  },
  "compilerRelease": "16.2.0-open3"
}
