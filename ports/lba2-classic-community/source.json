        "commit": "2fa1c7a66de2ce8707d85cb9a304dbd6f96c8ab8",
        "submodules": false
      },
      "contentPolicy": "GPL-2.0-only engine and bundled third-party notices. Classic retail data stays user-supplied; no game assets are fetched or packaged.",
