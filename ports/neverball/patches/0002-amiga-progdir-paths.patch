--- a/share/base_config.c
+++ b/share/base_config.c
@@ -88,7 +88,10 @@ void config_paths(const char *arg_data_path)
     /* Force IndexedDB-backed location created during Module['preRun']. */
     user = strdup("/neverball");
 #else
-    user = concat_string(home, "/", CONFIG_USER, NULL);
+    if (path_is_abs(CONFIG_USER))
+        user = strdup(CONFIG_USER);
+    else
+        user = path_join(home, CONFIG_USER);
 #endif
 
     /* Set up directory for writing, create if needed. */
