diff --git a/share/fs_stdio.c b/share/fs_stdio.c
index 7832c73..e265934 100644
--- a/share/fs_stdio.c
+++ b/share/fs_stdio.c
@@ -17,6 +17,7 @@
 #include <assert.h>
 #include <string.h>
 #include <errno.h>
+#include <ctype.h>
 
 #include "fs.h"
 #include "dir.h"
@@ -26,6 +27,11 @@
 #include "log.h"
 #include "zip.h"
 
+#ifdef __amigaos__
+#include <proto/dos.h>
+#include <dos/dos.h>
+#endif
+
 /*
  * This file implements the low-level virtual file system routines
  * using stdio.
@@ -96,9 +102,118 @@ static char *fs_dir_write;
 static List  fs_path;
 static int   fs_logging = 1;
 
+#ifdef __amigaos__
+
+/*
+ * PROGDIR: names the folder the program was started from, but only for
+ * this process: a thread or a helper that another library starts has no
+ * such folder, and a file asked for there makes AmigaDOS ask for a volume
+ * called PROGDIR:.  Joined to the base folder, it is worse still:
+ * "./PROGDIR:data" is read as a volume called "./PROGDIR".  So at start-up
+ * PROGDIR: is turned into the folder's real path ("DH1:Games/Neverball"),
+ * and every path the game uses is built from that.
+ */
+
+static char amiga_progdir[MAXSTR];
+
+static void amiga_progdir_init(void)
+{
+    BPTR lock;
+
+    amiga_progdir[0] = '\0';
+
+    lock = GetProgramDir();
+    if (lock && NameFromLock(lock, amiga_progdir, sizeof (amiga_progdir)))
+        return;
+
+    amiga_progdir[0] = '\0';
+
+    /* Started without a program folder: the current directory. */
+
+    lock = Lock("", SHARED_LOCK);
+    if (lock)
+    {
+        if (!NameFromLock(lock, amiga_progdir, sizeof (amiga_progdir)))
+            amiga_progdir[0] = '\0';
+        UnLock(lock);
+    }
+}
+
+static int amiga_has_progdir(const char *path)
+{
+    static const char prefix[] = "PROGDIR:";
+    int i;
+
+    if (!path)
+        return 0;
+
+    for (i = 0; prefix[i]; i++)
+        if (!path[i] || toupper((unsigned char) path[i]) != prefix[i])
+            return 0;
+
+    return 1;
+}
+
+int fs_amiga_progdir(const char *path)
+{
+    return amiga_has_progdir(path) ? 8 : 0;
+}
+
+const char *fs_amiga_path(const char *path)
+{
+    static char buff[4][MAXSTR];
+    static int  next;
+
+    char *dst;
+    size_t len;
+
+    if (!amiga_has_progdir(path) || !amiga_progdir[0])
+        return path;
+
+    dst = buff[next++ & 3];
+
+    /* (SAFECPY and SAFECAT size a char array, not a pointer.) */
+    strncpy(dst, amiga_progdir, MAXSTR - 1);
+    dst[MAXSTR - 1] = '\0';
+
+    if (path[8])
+    {
+        len = strlen(dst);
+
+        if (len && len < MAXSTR - 1 && dst[len - 1] != ':' && dst[len - 1] != '/')
+            dst[len++] = '/';
+
+        strncpy(dst + len, path + 8, MAXSTR - 1 - len);
+        dst[MAXSTR - 1] = '\0';
+    }
+
+    return dst;
+}
+
+#else
+
+int fs_amiga_progdir(const char *path)
+{
+    (void) path;
+    return 0;
+}
+
+const char *fs_amiga_path(const char *path)
+{
+    return path;
+}
+
+#endif
+
 int fs_init(const char *argv0)
 {
+#ifdef __amigaos__
+    amiga_progdir_init();
+    fs_dir_base = strdup(amiga_progdir[0] ? amiga_progdir :
+                         argv0 && *argv0 ? dir_name(argv0) : ".");
+#else
     fs_dir_base  = strdup(argv0 && *argv0 ? dir_name(argv0) : ".");
+#endif
     fs_dir_write = NULL;
     fs_path      = NULL;
     fs_logging   = 1;
