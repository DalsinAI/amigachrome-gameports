diff --git a/share/common.c b/share/common.c
index 512ef2a..7299376 100644
--- a/share/common.c
+++ b/share/common.c
@@ -232,6 +232,17 @@ int path_is_abs(const char *path)
     if (path_is_sep(path[0]))
         return 1;
 
+#ifdef __amigaos__
+    /* A volume or assign ("DH1:Games", "PROGDIR:data") starts a full path. */
+    {
+        const char *colon = strchr(path, ':');
+        const char *slash = strchr(path, '/');
+
+        if (colon && (!slash || colon < slash))
+            return 1;
+    }
+#endif
+
 #ifdef _WIN32
     if (isalpha(path[0]) && path[1] == ':' && path_is_sep(path[2]))
         return 1;
