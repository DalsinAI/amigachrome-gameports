    if (old_position != player_position)
        race_elapsed_ms += 1000 / FRAME_HZ;
    update_rank();
    of_audio_set_engine(current_rpm(), throttle ? 255U : 32U,
                        (unsigned)player_speed, steering * 22000);
}

static void update_game(const acgame_input_state *input)
{
    ++game_frame;
    if (game_state == STATE_TITLE) {
        title_scroll += 150 / FRAME_HZ;
        if (title_scroll >= track_length)
            title_scroll -= track_length;
        player_position = title_scroll;
        player_speed = 7300;
        player_lane_q16 = 0;
        of_audio_set_engine(7600, 90, 7300, 0);
        if (input->key[ACGAME_KEY_START] || input->key[ACGAME_KEY_FIRE1] || input->mouse_buttons)
            reset_race();
        return;
    }

    if (game_state == STATE_COUNTDOWN) {
        int previous = countdown_frames;
        --countdown_frames;
        if (countdown_frames < 0) {
            game_state = STATE_RACE;
            lap_start_ms = (int)acgame_platform_ticks_ms();
            of_audio_beep(4);
        } else if (countdown_frames / FRAME_HZ != previous / FRAME_HZ) {
            of_audio_beep(1);
        }
        of_audio_set_engine(4200, input->key[ACGAME_KEY_FIRE1] ? 200U : 40U, 0, 0);
        return;
    }

    if (game_state == STATE_RACE) {
        update_ai();
        update_player(input);
        return;
    }

    if (game_state == STATE_FINISHED) {
        player_speed -= 80;
        if (player_speed < 0) player_speed = 0;
        player_position += player_speed / FRAME_HZ;
        if (player_position >= track_length) player_position -= track_length;
        update_ai();
        of_audio_set_engine(current_rpm(), 20, (unsigned)player_speed, 0);
        if (input->key[ACGAME_KEY_START] || input->key[ACGAME_KEY_FIRE1] || input->mouse_buttons)
            game_state = STATE_TITLE;
    }
}

/* ---- HUD and screens -------------------------------------------------- */

static void format_time(char *buffer, size_t size, int milliseconds)
{
    int minutes, seconds, millis;
    if (milliseconds < 0) milliseconds = 0;
    minutes = milliseconds / 60000;
    seconds = (milliseconds / 1000) % 60;
    millis = milliseconds % 1000;
    snprintf(buffer, size, "%d:%02d.%03d", minutes, seconds, millis);
}

static void draw_hud(void)
{
    char line[64];
    char time_text[24];
    int kmh = player_speed * 330 / MAX_SPEED;
    int gear = current_gear();
    int lap_display = player_lap + 1;
    int rpm_bar = (int)(current_rpm() - 4000) * 120 / 8000;
    if (lap_display > race_laps) lap_display = race_laps;

    fill_rect(0, 0, GAME_W, 22, COL_PANEL);
    fill_rect(0, 22, GAME_W, 2, COL_PANEL2);
    snprintf(line, sizeof(line), "LAP %d/%d", lap_display, race_laps);
    draw_text(8, 7, line, COL_WHITE, 1);
    snprintf(line, sizeof(line), "POS %d/%d", player_rank, MAX_CARS);
    draw_text(96, 7, line, COL_YELLOW, 1);
    format_time(time_text, sizeof(time_text), race_elapsed_ms);
    draw_text(210, 7, time_text, COL_CYAN, 1);
    snprintf(line, sizeof(line), "%3d KM/H", kmh);
    draw_text(438, 5, line, COL_WHITE, 2);

    fill_rect(8, GAME_H - 18, 128, 10, COL_PANEL);
    fill_rect(12, GAME_H - 15, clamp_int(rpm_bar, 0, 120), 4,
              rpm_bar > 104 ? COL_RED : (rpm_bar > 84 ? COL_ORANGE : COL_GREEN));
    snprintf(line, sizeof(line), "GEAR %d", gear);
    draw_text(146, GAME_H - 17, line, COL_WHITE, 1);
    if (best_lap_ms) {
        format_time(time_text, sizeof(time_text), best_lap_ms);
        snprintf(line, sizeof(line), "BEST %s", time_text);
        draw_text(GAME_W - text_width(line, 1) - 8, GAME_H - 17, line, COL_GREY, 1);
    }
}

static void draw_countdown(void)
{
    char text[8];
    int second = countdown_frames / FRAME_HZ;
    if (second > 0)
        snprintf(text, sizeof(text), "%d", second);
    else
        strcpy(text, "GO!");
    fill_rect(GAME_W / 2 - 52, 52, 104, 70, COL_PANEL);
    draw_text_center(66, text, second > 0 ? COL_YELLOW : COL_GREEN, 6);
}

static void draw_title(void)
{
    char platform[80];
    draw_text_center(36, "OPENFORMULA 68K", COL_WHITE, 4);
    draw_text_center(73, "GRAND PRIX", COL_YELLOW, 2);
    fill_rect(104, 104, 432, 2, COL_RED);
    draw_text_center(118, "BOING RING - 12 CARS - 3 LAPS", COL_CYAN, 1);
    draw_text_center(260, "CURSORS OR PAD TO STEER", COL_WHITE, 1);
    draw_text_center(275, "FIRE OR UP TO ACCELERATE", COL_WHITE, 1);
    draw_text_center(299, "PRESS FIRE OR RETURN", COL_YELLOW, 2);
    snprintf(platform, sizeof(platform), "RTG %ux%u  %s  AHI %s",
             platform_info.screen_width, platform_info.screen_height,
             platform_info.opengfx ? "OPEN GFX" : "CHUNKY",
             of_audio_available() ? "ON" : "OFF");
    draw_text_center(337, platform, COL_GREY, 1);
}

static void draw_finish(void)
{
    char line[64];
    fill_rect(80, 64, GAME_W - 160, 170, COL_PANEL);
    fill_rect(84, 68, GAME_W - 168, 162, COL_PANEL2);
    draw_text_center(84, "CHEQUERED FLAG", COL_WHITE, 3);
    snprintf(line, sizeof(line), "FINISHED P%d", finish_place);
    draw_text_center(126, line, finish_place <= 3 ? COL_YELLOW : COL_CYAN, 3);
    format_time(line, sizeof(line), race_elapsed_ms);
    draw_text_center(166, line, COL_WHITE, 2);
    if (best_lap_ms) {
        char time_text[24];
        format_time(time_text, sizeof(time_text), best_lap_ms);
        snprintf(line, sizeof(line), "BEST LAP %s", time_text);
        draw_text_center(197, line, COL_GREEN, 1);
    }
    draw_text_center(215, "PRESS FIRE", COL_GREY, 1);
}

static void render_frame(void)
{
    int base;
    frame_surface = acgame_platform_begin_indexed_frame();
    if (!frame_surface)
        return;
    set_palette();
    memset(frame_surface->pixels, COL_BLACK, frame_surface->pitch * frame_surface->height);
    base = build_projection();
    draw_sky(track[base].curve * 20);
    draw_road();
    draw_trackside();
    draw_ai_cars();
    draw_player_car();

    if (game_state == STATE_TITLE)
        draw_title();
    else {
        draw_hud();
        if (game_state == STATE_COUNTDOWN)
            draw_countdown();
        else if (game_state == STATE_FINISHED)
            draw_finish();
    }

    acgame_platform_present_indexed(frame_surface);
}

/* ---- command line and main ------------------------------------------- */

static int parse_number(const char *text, int fallback)
{
    char *end = NULL;
    long value;
    if (!text || !*text)
        return fallback;
    value = strtol(text, &end, 10);
    if (!end || *end)
        return fallback;
    return (int)value;
}

static void usage(void)
{
    printf("OpenFormula68K [LAPS=n] [SECONDS="n] [NOAUDIO] [AUTOSTART] [AUTO] [AGA]\n");
    printf("  Default display is RTG 640x360 indexed chunky.\n");
    printf("  AUTO lets ACGame pick RTG or AGA; AGA forces a planar screen.\n");
}

int main(int argc, char **argv)
{
    acgame_video_config video;
    acgame_input_state input;
    int running = 1;
    int i;
    int rc = RETURN_FAIL;
    uint32_t start_ms;

    (void)version;
    for (i = 1; i < argc; ++i) {
        if (!strncasecmp(argv[i], "LAPS=", 5))
            race_laps = clamp_int(parse_number(argv[i] + 5, DEFAULT_LAPS), 1, MAX_LAPS);
        else if (!strncasecmp(argv[i], "SECONDS=", 8))
            demo_seconds = clamp_int(parse_number(argv[i] + 8, 0), 0, 3600);
        else if (!strcasecmp(argv[i], "NOAUDIO"))
            no_audio = 1;
        else if (!strcasecmp(argv[i], "AUTOSTART"))
            auto_start = 1;
        else if (!strcasecmp(argv[i], "AUTO"))
            force_rtg = 0;
        else if (!strcasecmp(argv[i], "AGA"))
            force_rtg = -1;
        else if (!strcasecmp(argv[i], "HELP") || !strcmp(argv[i], "?")) {
            usage();
            return RETUN_OK;
        } else {
            printf("OpenFormula68K: unknown option %s\n", argv[i]);
            usage();
            return RETUN_ERROR;
        }
    }

    build_track();
    memset(&video, 0, sizeof(video));
    video.width = GAME_W;
    video.height = GAME_H;
    video.refresh_hz = FRAME_HZ;
    video.mode = ACGAME_VIDEO_INDEXED8
    video.display = force_rtg > 0 ? ACGAME_DISPLAY_RTG :
                    (force_rtg < 0 ? ACGAME_DISPLAY_AGA : ACGAME_DISPLAY_AUTO);

    if (acgame_platform_init(&video) != 0) {
        printf("OpenFormula68K: could not open a %s 8-bit display\n",
               force_rtg > 0 ? "RTG" : (force_rtg < 0 ? "AGA" : "compatible"));
        return RETURN_FAIL;
    }
    if (acgame_platform_get_info(&platform_info) != 0)
        memset(&platform_info, 0, sizeof(platform_info));
    if (!no_audio)
        of_audio_start();

    printf("OpenFormula68K: %ux%u %s, %s, AHI %s\n",
           platform_info.screen_width, platform_info.screen_height,
           platform_info.planar ? "planar AGA" : "RTG chunky",
           platform_info.opengfx ? "OpenGfx accelerated" : "graphics.library",
           of_audio_available() ? "active" : "unavailable");

    if (auto_start)
        reset_race();

    start_ms = acgame_platform_ticks_ms();
    while (running) {
        acgame_platform_poll(&input);
        if (input.quit_requested || input.key[ACGAME_KEY_ESCAPE])
            running = 0;
        if (SetSignal(0, SIGBREAKF_CTRL_C) & SIGBREAKF_CTRL_C)
            running = 0;
        if (demo_seconds > 0 && acgame_platform_ticks_ms() - start_ms >= (uint32_t)demo_seconds * 1000U)
            running = 0;
        if (!running)
            break;
        update_game(&input);
        render_frame();
    }

    of_audio_stop();
    acgame_platform_shutdown();
    rc = RETURN_OK;
    printf("OpenFormula68K: returned RC %d after %d frames\n", rc, game_frame);
    return rc;
}
