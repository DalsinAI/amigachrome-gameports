    acgame_input_state input;
    int running = 1;
    int i;
    int rc = RETURN_FAIL;
    uint32_t start_ms;

    (void)version;
    for (i = 1; i < argc; ++i) {
        if (!strncasecmp(argv[i], "LAPS=", 5))
            race_laps = clamp_int(parse_number(argv[i] + 5, DEFAULT_LAPS), 1, MAX_LAPS);
        else if (!strncasecmp(argv[i], "SECONDS=", 8))
            demo_seconds = clamp_int(parse_number(argv[i] + 8, 0), 0, 3600);
        else if (!strcasecmp(argv[i], "NOAUDIO"))
            no_audio = 1;
        else if (!strcasecmp(argv[i], "AUTOSTART"))
            auto_start = 1;
        else if (!strcasecmp(argv[i], "AUTO"))
            force_rtg = 0;
        else if (!strcasecmp(argv[i], "AGA"))
            force_rtg = -1;
        else if (!strcasecmp(argv[i], "HELP") || !strcmp(argv[i], "?")) {
            usage();
            return RETURN_OK;
        } else {
            printf("OpenFormula68K: unknown option %s\n", argv[i]);
            usage();
            return RETURN_ERROR;
        }
    }

    build_track();
    memset(&video, 0, sizeof(video));
    video.width = GAME_W;
    video.height = GAME_H;
    video.refresh_hz = FRAME_HZ;
    video.mode = ACGAME_VIDEO_INDEXED8;
    video.display = force_rtg > 0 ? ACGAME_DISPLAY_RTG :
                    (force_rtg < 0 ? ACGAME_DISPLAY_AGA : ACGAME_DISPLAY_AUTO);

