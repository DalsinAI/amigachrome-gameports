+/* A directory may be writable while in use as CurrentDir/PROGDIR. libnix
+ * access(W_OK) attempts an exclusive DOS lock and mistakes that normal use
+ * for write protection. Check the directory protection bits on Amiga; the
+ * actual file-open still reports read-only media and other write failures. */
+static bool writable_config_directory(const char *path) {
+#ifdef __amigaos__
+    struct stat info;
+    return stat(path, &info) == 0 && S_ISDIR(info.st_mode) &&
+           (info.st_mode & S_IWUSR) != 0;
+#else
+    return access(path, W_OK) == 0;
+#endif
+}
