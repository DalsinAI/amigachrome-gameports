diff --git a/cmake/OpenLocoVersion.cmake b/cmake/OpenLocoVersion.cmake
index 357ce82..cb81083 100644
--- a/cmake/OpenLocoVersion.cmake
+++ b/cmake/OpenLocoVersion.cmake
@@ -1,3 +1,17 @@
+# An exported, pinned source tree must not read the parent recipe repository.
+if(OPENLOCO_SOURCE_COMMIT)
+    string(LENGTH "${OPENLOCO_SOURCE_COMMIT}" pin_length)
+    if(NOT pin_length EQUAL 40 OR NOT OPENLOCO_SOURCE_COMMIT MATCHES "^[0-9a-f]+$")
+        message(FATAL_ERROR "OPENLOCO_SOURCE_COMMIT must be a full commit ID")
+    endif()
+    set(OPENLOCO_VERSION_TAG "${PROJECT_VERSION}")
+    set(OPENLOCO_BRANCH "amiga-sdl3")
+    string(SUBSTRING "${OPENLOCO_SOURCE_COMMIT}" 0 7 OPENLOCO_COMMIT_SHA1_SHORT)
+    # Match the runner's compiler prefix map before SourceLocation removes it.
+    set(OPENLOCO_PROJECT_PATH "/port-build/source")
+    return()
+endif()
+
 include(FindGit)
 
 find_package(Git)
