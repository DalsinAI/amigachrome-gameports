diff --git a/src/Audio/include/OpenLoco/Audio/CssFile.hpp b/src/Audio/include/OpenLoco/Audio/CssFile.hpp
new file mode 100644
index 0000000..db783e3
--- /dev/null
+++ b/src/Audio/include/OpenLoco/Audio/CssFile.hpp
@@ -0,0 +1,50 @@
+// Copyright (c) 2026 Dalsin Limited. MIT licensed.
+#pragma once
+#include "AudioFormat.h"
+#include <OpenLoco/Core/DataEndian.hpp>
+#include <vector>
+
+namespace OpenLoco::Audio
+{
+    struct CssSoundView
+    {
+        WAVEFORMATEX format;
+        std::span<const std::byte> pcm;
+    };
+    inline WAVEFORMATEX decodeWaveFormat(std::span<const std::byte> data)
+    {
+        using Utility::readLittleEndian;
+        WAVEFORMATEX format{ readLittleEndian<int16_t>(data), readLittleEndian<int16_t>(data, 2),
+            readLittleEndian<int32_t>(data, 4), readLittleEndian<int32_t>(data, 8),
+            readLittleEndian<int16_t>(data, 12), readLittleEndian<int16_t>(data, 14), readLittleEndian<int16_t>(data, 16) };
+        if (format.wFormatTag != 1 || (format.nChannels != 1 && format.nChannels != 2)
+            || (format.wBitsPerSample != 8 && format.wBitsPerSample != 16)
+            || format.nSamplesPerSec <= 0 || format.cbSize != 0
+            || format.nBlockAlign != format.nChannels * (format.wBitsPerSample / 8)
+            || static_cast<int64_t>(format.nSamplesPerSec) * format.nBlockAlign != format.nAvgBytesPerSec)
+            throw std::runtime_error("Unsupported or inconsistent CSS PCM format");
+        return format;
+    }
+    inline std::vector<CssSoundView> decodeCssFile(std::span<const std::byte> data)
+    {
+        using Utility::readLittleEndian;
+        const auto count = readLittleEndian<uint32_t>(data);
+        if (data.size() < 4 || count > (data.size() - 4) / 4)
+            throw std::runtime_error("CSS offset table exceeds file");
+        const size_t tableEnd = 4 + static_cast<size_t>(count) * 4;
+        std::vector<CssSoundView> result;
+        result.reserve(count);
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            const auto offset = readLittleEndian<uint32_t>(data, 4 + static_cast<size_t>(i) * 4);
+            if (offset < tableEnd || offset > data.size() || data.size() - offset < 22)
+                throw std::runtime_error("CSS sound header exceeds file");
+            const auto length = readLittleEndian<uint32_t>(data, offset);
+            auto format = decodeWaveFormat(data.subspan(offset + 4, 18));
+            if (length > data.size() - offset - 22 || length % format.nBlockAlign != 0)
+                throw std::runtime_error("CSS sample exceeds file or frame boundary");
+            result.push_back({ format, data.subspan(offset + 22, length) });
+        }
+        return result;
+    }
+}
diff --git a/src/Core/include/OpenLoco/Core/DataEndian.hpp b/src/Core/include/OpenLoco/Core/DataEndian.hpp
new file mode 100644
index 0000000..d808dae
--- /dev/null
+++ b/src/Core/include/OpenLoco/Core/DataEndian.hpp
@@ -0,0 +1,40 @@
+// Copyright (c) 2026 Dalsin Limited. MIT licensed.
+#pragma once
+#include "Stream.hpp"
+#include <array>
+#include <bit>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <stdexcept>
+#include <type_traits>
+
+namespace OpenLoco::Utility
+{
+    template<typename T>
+    T readLittleEndian(std::span<const std::byte> data, size_t offset = 0)
+    {
+        static_assert(std::is_integral_v<T> && !std::is_same_v<T, bool>);
+        if (offset > data.size() || sizeof(T) > data.size() - offset)
+            throw std::runtime_error("Truncated little-endian field");
+        using U = std::make_unsigned_t<T>;
+        U value = 0;
+        for (size_t i = 0; i < sizeof(T); ++i)
+            value |= static_cast<U>(std::to_integer<uint8_t>(data[offset + i])) << (i * 8);
+        return std::bit_cast<T>(value);
+    }
+
+    template<typename T>
+    T readLittleEndian(Stream& stream)
+    {
+        std::array<std::byte, sizeof(T)> data{};
+        stream.read(data.data(), data.size());
+        return readLittleEndian<T>(data);
+    }
+
+    // The caller owns and has validated the two-byte row-offset table.
+    inline uint16_t readLittleEndian16(const uint8_t* data)
+    {
+        return static_cast<uint16_t>(data[0]) | (static_cast<uint16_t>(data[1]) << 8);
+    }
+}
diff --git a/src/OpenLoco/include/OpenLoco/Graphics/G1File.hpp b/src/OpenLoco/include/OpenLoco/Graphics/G1File.hpp
new file mode 100644
index 0000000..201fe0e
--- /dev/null
+++ b/src/OpenLoco/include/OpenLoco/Graphics/G1File.hpp
@@ -0,0 +1,79 @@
+// Copyright (c) 2026 Dalsin Limited. MIT licensed.
+#pragma once
+#include "Gfx.h"
+#include <OpenLoco/Core/DataEndian.hpp>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+namespace OpenLoco::Gfx
+{
+    struct G1FileView
+    {
+        G1Header header;
+        std::vector<G1Element32> elements;
+        std::span<const std::byte> pixels;
+        uint32_t bytesConsumed;
+    };
+
+    inline G1FileView decodeG1File(std::span<const std::byte> data, size_t maxEntries)
+    {
+        using Utility::readLittleEndian;
+        const G1Header header{ readLittleEndian<uint32_t>(data), readLittleEndian<uint32_t>(data, 4) };
+        if (header.numEntries > maxEntries || data.size() < 8 || header.numEntries > (data.size() - 8) / 16)
+            throw std::runtime_error("G1 entry table exceeds file or image capacity");
+        const size_t pixelStart = 8 + static_cast<size_t>(header.numEntries) * 16;
+        if (header.totalSize > data.size() - pixelStart || pixelStart > std::numeric_limits<uint32_t>::max() - header.totalSize)
+            throw std::runtime_error("G1 pixel data exceeds file");
+        G1FileView result{ header, {}, data.subspan(pixelStart, header.totalSize), static_cast<uint32_t>(pixelStart + header.totalSize) };
+        result.elements.reserve(header.numEntries);
+        for (uint32_t i = 0; i < header.numEntries; ++i)
+        {
+            const size_t p = 8 + static_cast<size_t>(i) * 16;
+            G1Element32 e{ readLittleEndian<uint32_t>(data, p), readLittleEndian<int16_t>(data, p + 4),
+                readLittleEndian<int16_t>(data, p + 6), readLittleEndian<int16_t>(data, p + 8),
+                readLittleEndian<int16_t>(data, p + 10), static_cast<G1ElementFlags>(readLittleEndian<uint16_t>(data, p + 12)),
+                readLittleEndian<int16_t>(data, p + 14) };
+            const auto flags = static_cast<uint16_t>(e.flags);
+            if ((flags & static_cast<uint16_t>(G1ElementFlags::duplicatePrevious)) != 0)
+            {
+                if (i == 0) throw std::runtime_error("G1 first entry cannot duplicate a predecessor");
+            }
+            else
+            {
+                if (e.width < 0 || e.height < 0 || e.offset > result.pixels.size())
+                    throw std::runtime_error("Invalid G1 image bounds");
+                const auto pixels = result.pixels.subspan(e.offset);
+                if ((flags & static_cast<uint16_t>(G1ElementFlags::isRLECompressed)) != 0)
+                {
+                    if (static_cast<size_t>(e.height) * 2 > pixels.size())
+                        throw std::runtime_error("Truncated G1 RLE row table");
+                    for (int row = 0; row < e.height; ++row)
+                    {
+                        size_t cursor = readLittleEndian<uint16_t>(pixels, static_cast<size_t>(row) * 2);
+                        for (;;)
+                        {
+                            if (cursor > pixels.size() || pixels.size() - cursor < 2)
+                                throw std::runtime_error("Truncated G1 RLE run");
+                            const auto code = std::to_integer<uint8_t>(pixels[cursor]);
+                            const auto count = code & 0x7f;
+                            cursor += 2;
+                            if (count > pixels.size() - cursor)
+                                throw std::runtime_error("G1 RLE pixels exceed file");
+                            cursor += count;
+                            if ((code & 0x80) != 0) break;
+                        }
+                    }
+                }
+                else
+                {
+                    const size_t length = (flags & static_cast<uint16_t>(G1ElementFlags::isR8G8B8Palette)) != 0
+                        ? static_cast<size_t>(e.width) * 3 : static_cast<size_t>(e.width) * e.height;
+                    if (length > pixels.size()) throw std::runtime_error("Truncated G1 bitmap or palette");
+                }
+            }
+            result.elements.push_back(e);
+        }
+        return result;
+    }
+}
