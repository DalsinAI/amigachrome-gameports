+template<class T,class F> inline void walk(T& value,F&& f) {
+    if constexpr(std::is_integral_v<T> || std::is_enum_v<T>) f(reinterpret_cast<uint8_t*>(&value),sizeof(T));
+    else if constexpr(std::is_array_v<T>) { for(auto& item:value) walk(item,f); }
+    else fields(value,[&](auto& item){walk(item,f);});
+}
