+    case TreeObject::kObjectType: return sizeof(TreeObject);
+    case TunnelObject::kObjectType: return sizeof(TunnelObject);
+    case VehicleObject::kObjectType: return sizeof(VehicleObject);
+    case WallObject::kObjectType: return sizeof(WallObject);
+    case WaterObject::kObjectType: return sizeof(WaterObject);
+    default: throw std::runtime_error("Unknown object type");
+} }
+template<class F> inline void walkFixedFields(ObjectType type,std::span<std::byte> data,F&& f) {
+    if(data.size()<fixedHeaderSize(type)) throw std::runtime_error("Truncated fixed object fields");
+    switch(type) {
+    case AirportObject::kObjectType: walk(*reinterpret_cast<AirportObject*>(data.data()),f);break;
+    case BridgeObject::kObjectType: walk(*reinterpret_cast<BridgeObject*>(data.data()),f);break;
+    case BuildingObject::kObjectType: walk(*reinterpret_cast<BuildingObject*>(data.data()),f);break;
+    case CargoObject::kObjectType: walk(*reinterpret_cast<CargoObject*>(data.data()),f);break;
+    case CliffEdgeObject::kObjectType: walk(*reinterpret_cast<CliffEdgeObject*>(data.data()),f);break;
+    case ClimateObject::kObjectType: walk(*reinterpret_cast<ClimateObject*>(data.data()),f);break;
+    case CompetitorObject::kObjectType: walk(*reinterpret_cast<CompetitorObject*>(data.data()),f);break;
+    case CurrencyObject::kObjectType: walk(*reinterpret_cast<CurrencyObject*>(data.data()),f);break;
+    case DockObject::kObjectType: walk(*reinterpret_cast<DockObject*>(data.data()),f);break;
+    case HillShapesObject::kObjectType: walk(*reinterpret_cast<HillShapesObject*>(data.data()),f);break;
+    case IndustryObject::kObjectType: walk(*reinterpret_cast<IndustryObject*>(data.data()),f);break;
+    case InterfaceSkinObject::kObjectType: walk(*reinterpret_cast<InterfaceSkinObject*>(data.data()),f);break;
+    case LandObject::kObjectType: walk(*reinterpret_cast<LandObject*>(data.data()),f);break;
+    case LevelCrossingObject::kObjectType: walk(*reinterpret_cast<LevelCrossingObject*>(data.data()),f);break;
+    case RegionObject::kObjectType: walk(*reinterpret_cast<RegionObject*>(data.data()),f);break;
+    case RoadExtraObject::kObjectType: walk(*reinterpret_cast<RoadExtraObject*>(data.data()),f);break;
+    case RoadObject::kObjectType: walk(*reinterpret_cast<RoadObject*>(data.data()),f);break;
+    case RoadStationObject::kObjectType: walk(*reinterpret_cast<RoadStationObject*>(data.data()),f);break;
+    case ScaffoldingObject::kObjectType: walk(*reinterpret_cast<ScaffoldingObject*>(data.data()),f);break;
+    case ScenarioTextObject::kObjectType: walk(*reinterpret_cast<ScenarioTextObject*>(data.data()),f);break;
+    case SnowObject::kObjectType: walk(*reinterpret_cast<SnowObject*>(data.data()),f);break;
+    case SoundObject::kObjectType: walk(*reinterpret_cast<SoundObject*>(data.data()),f);break;
+    case SteamObject::kObjectType: walk(*reinterpret_cast<SteamObject*>(data.data()),f);break;
+    case StreetLightObject::kObjectType: walk(*reinterpret_cast<StreetLightObject*>(data.data()),f);break;
+    case TownNamesObject::kObjectType: walk(*reinterpret_cast<TownNamesObject*>(data.data()),f);break;
+    case TrackExtraObject::kObjectType: walk(*reinterpret_cast<TrackExtraObject*>(data.data()),f);break;
+    case TrackObject::kObjectType: walk(*reinterpret_cast<TrackObject*>(data.data()),f);break;
+    case TrainSignalObject::kObjectType: walk(*reinterpret_cast<TrainSignalObject*>(data.data()),f);break;
+    case TrainStationObject::kObjectType: walk(*reinterpret_cast<TrainStationObject*>(data.data()),f);break;
+    case TreeObject::kObjectType: walk(*reinterpret_cast<TreeObject*>(data.data()),f);break;
+    case TunnelObject::kObjectType: walk(*reinterpret_cast<TunnelObject*>(data.data()),f);break;
+    case VehicleObject::kObjectType: walk(*reinterpret_cast<VehicleObject*>(data.data()),f);break;
+    case WallObject::kObjectType: walk(*reinterpret_cast<WallObject*>(data.data()),f);break;
+    case WaterObject::kObjectType: walk(*reinterpret_cast<WaterObject*>(data.data()),f);break;
+    default: throw std::runtime_error("Unknown object type");
+} }
+inline void swapFixedFields(ObjectType type,std::span<std::byte> data) {
+    walkFixedFields(type,data,[](uint8_t* p,size_t size){std::reverse(p,p+size);});
+}
+inline void decodeFixedFields(ObjectType type,std::span<std::byte> data) {
+    if(data.size()<fixedHeaderSize(type)) throw std::runtime_error("Truncated fixed object fields");
+    if constexpr(std::endian::native==std::endian::big) swapFixedFields(type,data);
+}
+inline std::vector<std::byte> canonicalFixedFields(ObjectType type,std::span<std::byte> data) {
+    std::vector<std::byte> result;
+    walkFixedFields(type,data,[&](uint8_t* p,size_t size){
+        for(size_t i=0;i<size;++i) result.push_back(std::byte(p[std::endian::native==std::endian::big?size-1-i:i]));
+    });return result;
+}
+}
