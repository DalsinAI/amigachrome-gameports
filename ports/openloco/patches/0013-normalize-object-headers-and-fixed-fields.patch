new file mode 100644
index 0000000..bc96cd3
--- /dev/null
+++ b/src/OpenLoco/include/OpenLoco/Objects/ObjectWire.hpp
@@ -0,0 +1,40 @@
+// Copyright (c) 2026 Dalsin Limited. MIT licensed.
+#pragma once
+#include "Object.h"
+#include <OpenLoco/Core/DataEndian.hpp>
+#include <array>
+#include <bit>
+#include <cstring>
+
+namespace OpenLoco::ObjectWire
+{
+    inline ObjectHeader decodeHeader(std::span<const std::byte> data)
+    {
+        if(data.size()<sizeof(ObjectHeader)) throw std::runtime_error("Truncated object header");
+        ObjectHeader result{};
+        result.flags=Utility::readLittleEndian<uint32_t>(data);
+        std::memcpy(result.name,data.data()+4,sizeof result.name);
+        result.checksum=Utility::readLittleEndian<uint32_t>(data,12);
+        return result;
+    }
+    inline uint32_t checksum(const ObjectHeader& header,std::span<const std::byte> data)
+    {
+        uint32_t result=0xF369A75B;
+        const auto add=[&](uint8_t value){result=std::rotl(result^value,11);};
+        add(static_cast<uint8_t>(header.flags&0xff));
+        for(char value:header.name)add(static_cast<uint8_t>(value));
+        for(std::byte value:data)add(std::to_integer<uint8_t>(value));
+        return result;
+    }
+    template<class TStream> ObjectHeader readHeader(TStream& stream)
+    {
+        std::array<std::byte,sizeof(ObjectHeader)> bytes{};
+        stream.read(bytes.data(),bytes.size());return decodeHeader(bytes);
+    }
+    inline std::array<std::byte,sizeof(ObjectHeader)> encodeHeader(const ObjectHeader& header)
+    {
+        std::array<std::byte,sizeof(ObjectHeader)> bytes{};
+        for(size_t i=0;i<4;++i){bytes[i]=std::byte((header.flags>>(i*8))&255);bytes[12+i]=std::byte((header.checksum>>(i*8))&255);}
+        std::memcpy(bytes.data()+4,header.name,sizeof header.name);return bytes;
+    }
+}
