+// Copyright (c) 2026 AmigaChrome Team. MIT licensed.
+#pragma once
+#include "S5.h"
+#include "S5Options.h"
+#include "Objects/ObjectWire.hpp"
+#include <OpenLoco/Core/DataEndian.hpp>
+#include <array>
+#include <bit>
+#include <cstring>
+
+namespace OpenLoco::S5::Wire
+{
+    constexpr uint32_t kVersion = 0x62262;
+
+    inline void requireSize(std::span<const std::byte> bytes, size_t expected)
+    {
+        if (bytes.size() != expected)
+            throw std::runtime_error("Invalid S5 chunk size");
+    }
+
+    inline void copyExact(std::span<const std::byte> bytes, void* destination, size_t expected)
+    {
+        requireSize(bytes, expected);
+        if (expected != 0)
+            std::memcpy(destination, bytes.data(), expected);
+    }
+
+    inline Header decodeHeader(std::span<const std::byte> bytes)
+    {
+        requireSize(bytes, sizeof(Header));
+        Header result{};
+        result.type = static_cast<S5Type>(std::to_integer<uint8_t>(bytes[0]));
+        result.flags = static_cast<HeaderFlags>(std::to_integer<uint8_t>(bytes[1]));
+        result.numPackedObjects = Utility::readLittleEndian<uint16_t>(bytes, 2);
+        result.version = Utility::readLittleEndian<uint32_t>(bytes, 4);
+        result.magic = Utility::readLittleEndian<uint32_t>(bytes, 8);
+        std::memcpy(result.padding, bytes.data() + 12, sizeof result.padding);
+        return result;
+    }
+
+    inline SaveDetails decodeSaveDetails(std::span<const std::byte> bytes)
+    {
+        requireSize(bytes, sizeof(SaveDetails));
+        SaveDetails result{};
+        std::memcpy(&result, bytes.data(), sizeof result);
+        result.date = Utility::readLittleEndian<uint32_t>(bytes, offsetof(SaveDetails, date));
+        result.performanceIndex = Utility::readLittleEndian<uint16_t>(bytes, offsetof(SaveDetails, performanceIndex));
+        result.challengeFlags = static_cast<CompanyFlags>(Utility::readLittleEndian<uint32_t>(bytes, offsetof(SaveDetails, challengeFlags)));
+        return result;
+    }
+
+    inline Options decodeOptions(std::span<const std::byte> bytes)
+    {
+        requireSize(bytes, sizeof(Options));
+        Options result{};
+        std::memcpy(&result, bytes.data(), sizeof result);
+        result.scenarioStartYear = Utility::readLittleEndian<uint16_t>(bytes, offsetof(Options, scenarioStartYear));
+        result.scenarioFlags = Utility::readLittleEndian<uint16_t>(bytes, offsetof(Options, scenarioFlags));
+        result.numberOfForests = Utility::readLittleEndian<uint16_t>(bytes, offsetof(Options, numberOfForests));
+        result.numberRandomTrees = Utility::readLittleEndian<uint16_t>(bytes, offsetof(Options, numberRandomTrees));
+        result.objective.companyValue = Utility::readLittleEndian<uint32_t>(bytes, offsetof(Options, objective) + offsetof(Objective, companyValue));
+        result.objective.monthlyVehicleProfit = Utility::readLittleEndian<uint32_t>(bytes, offsetof(Options, objective) + offsetof(Objective, monthlyVehicleProfit));
+        result.objective.deliveredCargoAmount = Utility::readLittleEndian<uint32_t>(bytes, offsetof(Options, objective) + offsetof(Objective, deliveredCargoAmount));
+        result.scenarioText = ObjectWire::decodeHeader(bytes.subspan(offsetof(Options, scenarioText), sizeof(ObjectHeader)));
+        result.objectiveDeliveredCargo = ObjectWire::decodeHeader(bytes.subspan(offsetof(Options, objectiveDeliveredCargo), sizeof(ObjectHeader)));
+        result.currency = ObjectWire::decodeHeader(bytes.subspan(offsetof(Options, currency), sizeof(ObjectHeader)));
+        return result;
+    }
+
+    // Metadata decoding does not make the packed simulation payload native.
+    // Do not pass it to importGameState before its complete schema is converted.
+    template<std::endian Endian = std::endian::native>
+    inline void requireGameStateSupport(const Header& header)
+    {
+        if (header.version != kVersion)
+            throw std::runtime_error("Unsupported S5 version");
+        if constexpr (Endian != std::endian::little)
+            throw std::runtime_error("S5 game-state endian conversion is not implemented");
+    }
+
+    inline size_t tileCount(std::span<const std::byte> bytes, size_t elementSize, size_t maximum)
+    {
+        if (elementSize == 0 || bytes.size() % elementSize != 0 || bytes.size() / elementSize > maximum)
+            throw std::runtime_error("Invalid S5 tile-element chunk size");
+        return bytes.size() / elementSize;
+    }
+
+    inline bool isLegacyGameState(std::span<const std::byte> bytes)
+    {
+        const auto flags = Utility::readLittleEndian<uint16_t>(bytes, 0x434);
+        return (flags & (enumValue(S5FixFlags::fixFlag0) | enumValue(S5FixFlags::fixFlag1))) == 0;
+    }
+}
