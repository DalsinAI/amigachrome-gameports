+template<class T,class F> inline void entityVariant(Entity& v,F&& f) {
+    static_assert(sizeof(T)<=sizeof(Entity));
+    static_assert(std::is_trivially_copyable_v<T> && std::is_trivially_copyable_v<Entity>);
+    T item{};
+    std::memcpy(static_cast<void*>(&item),static_cast<const void*>(&v),sizeof(T));
+    f(item);
+    std::memcpy(static_cast<void*>(&v),static_cast<const void*>(&item),sizeof(T));
+}
+template<class F> inline void fields(Entity& v,F&& f) {
+    // Discriminators are bytes, unchanged in either direction.
+    if(v.base.baseType==0xff) { f(v.base);return; }
+    if(v.base.baseType==0) {
+        switch(v.base.type) {
+            case 0:entityVariant<VehicleHead>(v,f);return;
+            case 1:entityVariant<Vehicle1>(v,f);return;
+            case 2:entityVariant<Vehicle2>(v,f);return;
+            case 3:entityVariant<VehicleBogie>(v,f);return;
+            case 4:case 5:entityVariant<VehicleBody>(v,f);return;
+            case 6:entityVariant<VehicleTail>(v,f);return;
+        }
+    } else if(v.base.baseType==1) {
+        switch(v.base.type) {
+            case 0:entityVariant<Exhaust>(v,f);return;
+            case 1:case 2:entityVariant<MoneyEffect>(v,f);return;
+            case 3:entityVariant<VehicleCrashParticle>(v,f);return;
+            case 4:entityVariant<ExplosionCloud>(v,f);return;
+            case 5:entityVariant<Splash>(v,f);return;
+            case 6:entityVariant<Fireball>(v,f);return;
+            case 7:entityVariant<ExplosionSmoke>(v,f);return;
+            case 8:entityVariant<Smoke>(v,f);return;
+        }
+    }
+    throw std::runtime_error("Invalid S5 entity variant");
+}
+}
