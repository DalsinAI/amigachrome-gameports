+template<class F> inline void fields(OpenLoco::S5::TileElement& v,F&& f) {
+    if(v.baseZ()==0xff) return;
+    const auto type=static_cast<unsigned>(v.type());
+    if(type>8)throw std::runtime_error("Invalid S5 tile type");
+    if(type==2 || type==4 || type==8) {
+        uint16_t n;std::memcpy(&n,v.rawData().data()+6,2);f(n);std::memcpy(v.rawData().data()+6,&n,2);
+    }
+}
+template<class T> inline void swapAll(T& v) {
+    if constexpr(std::is_array_v<T>) {
+        using E=std::remove_all_extents_t<T>;
+        if constexpr(sizeof(E)>1 || !(std::is_integral_v<E> || std::is_enum_v<E>))
+            for(auto& item:v)swapAll(item);
+    } else if constexpr(std::is_integral_v<T> || std::is_enum_v<T>) {
+        if constexpr(sizeof(T)>1) {
+            auto* p=reinterpret_cast<unsigned char*>(&v);std::reverse(p,p+sizeof(T));
+        }
+    } else if constexpr(isVector<T>) {
+        swapAll(v.x);swapAll(v.y);
+        if constexpr(requires {v.z;})swapAll(v.z);
+    } else fields(v,[](auto& member){swapAll(member);});
+}
+template<class T> inline void native(T& v) {
+    if constexpr(std::endian::native==std::endian::big)swapAll(v);
+}
+template<class T> inline std::vector<std::byte> encode(const T& v) {
+    static_assert(!std::is_array_v<T>);
+    std::vector<std::byte> bytes(sizeof(T));
+    if constexpr(std::endian::native==std::endian::big) {
+        auto copy=std::make_unique<T>();std::memcpy(copy.get(),&v,sizeof(T));swapAll(*copy);
+        std::memcpy(bytes.data(),copy.get(),sizeof(T));
+    } else std::memcpy(bytes.data(),&v,sizeof(T));
+    return bytes;
+}
+template<class T> inline std::vector<std::byte> encodeArray(std::span<const T> values) {
+    std::vector<T> copy(values.begin(),values.end());
+    if constexpr(std::endian::native==std::endian::big)
+        for(auto& v:copy)swapAll(v);
+    std::vector<std::byte> bytes(copy.size()*sizeof(T));
+    if(!bytes.empty())std::memcpy(bytes.data(),copy.data(),bytes.size());
+    return bytes;
+}
